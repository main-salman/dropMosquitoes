        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;WIRE 05: Gimbal Serial (UART)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Jetson /dev/ttyTHS0 → Storm32 RC_PITCH / RC_YAW pins&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="550" height="45" as="geometry"/></mxCell>
