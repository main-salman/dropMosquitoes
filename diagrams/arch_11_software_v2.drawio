        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;Software Architecture — Agent Pipeline&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;4 async agents + Flask GUI — thread-safe queue communication&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="600" height="45" as="geometry"/></mxCell>
