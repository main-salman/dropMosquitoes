        <mxCell id="sniper_rx" value="CSI→HDMI&#xa;RX Board 2&#xa;(on gimbal)" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="290" y="425" width="150" height="65" as="geometry"/></mxCell>
