        <mxCell id="t" value="ZONE 2: LOGIC &amp; DATA — Camera Chains, GPIO, and UART" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="10" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="leg" value="- - Blue Dashed = CSI/MIPI Data   - - Purple Dashed = FPC Ribbon   - - Orange Dashed = GPIO/UART   ● = Fixed Mount   ◆ = Gimbal Mount" style="text;html=1;fontSize=9;fontStyle=2;fillColor=#FFFFCC;strokeColor=#CC0;rounded=1;" vertex="1" parent="1"><mxGeometry x="100" y="45" width="700" height="22" as="geometry"/></mxCell>

        <mxCell id="note_scout" value="⚠️ CRITICAL: Scout camera is FIXED&#xa;to the enclosure lid or post — it does&#xa;NOT ride on the gimbal. It provides&#xa;wide-angle motion detection only." style="rounded=1;fillColor=#FFCC00;strokeColor=#CC9900;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="280" height="65" as="geometry"/></mxCell>

        <!-- ===== SCOUT CHAIN (FIXED) ===== -->
        <mxCell id="scout_box" value="" style="rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1500" height="170" as="geometry"/></mxCell>
        <mxCell id="scout_lbl" value="SCOUT CAMERA CHAIN (● FIXED to Post/Enclosure Lid)" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="50" y="175" width="500" height="20" as="geometry"/></mxCell>

        <mxCell id="scout_cam" value="📷 OV9281-110&#xa;1MP Mono&#xa;Global Shutter&#xa;120FPS" style="rounded=1;fillColor=#A5D6A7;strokeColor=#4CAF50;fontStyle=1;fontSize=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="scout_rx" value="CSI→HDMI&#xa;RX Board 1&#xa;(on camera side)" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="290" y="225" width="150" height="65" as="geometry"/></mxCell>
        <mxCell id="scout_hdmi" value="HDMI Cable&#xa;(up to 10m)" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="510" y="230" width="120" height="55" as="geometry"/></mxCell>
        <mxCell id="scout_tx" value="CSI→HDMI&#xa;TX Board 1&#xa;(inside IP67)" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="700" y="225" width="150" height="65" as="geometry"/></mxCell>
