        <!-- ===== JETSON CENTRAL + GPIO/UART ===== -->
        <mxCell id="jetson" value="🧠 Yahboom Jetson Orin Nano SUPER&#xa;8GB | JetPack 6 | 256GB SSD&#xa;40-Pin GPIO Header | UART TX/RX" style="rounded=1;fillColor=#76B947;strokeColor=#36802d;fontStyle=1;fontSize=12;fontColor=#FFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="550" y="600" width="400" height="120" as="geometry"/></mxCell>

