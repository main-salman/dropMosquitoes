        <mxCell id="gp1" value="3.3V GPIO&#xa;(40-pin jumper wire)" style="strokeColor=#FF8800;strokeWidth=2;dashed=1;endArrow=block;" edge="1" source="jetson" target="relay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

