        <mxCell id="gimbm1" value="" style="ellipse;fillColor=#455A64;strokeColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="870" y="435" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="gimbm2" value="" style="ellipse;fillColor=#455A64;strokeColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="900" y="435" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="gimblbl" value="&lt;b style='color:#B0BEC5;font-size:11px'&gt;Storm32 Gimbal&lt;/b&gt;&lt;br&gt;&lt;span style='color:#78909C;font-size:8px'&gt;TX=T8 | RX=T10 | GND=T14&lt;br&gt;Power via Relay CH2&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="160" height="35" as="geometry"/></mxCell>

