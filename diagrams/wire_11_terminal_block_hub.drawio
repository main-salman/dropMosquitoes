        <!-- Terminal mapping callout -->
        <mxCell id="map" value="&lt;b style='color:#333;font-size:10px'&gt;Active Terminals:&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#555'&gt;T2 = Relay 5V &amp;nbsp;|&amp;nbsp; T3 = LiDAR SDA&lt;br&gt;T4 = LiDAR 5V &amp;nbsp;|&amp;nbsp; T5 = LiDAR SCL&lt;br&gt;T6 = LiDAR GND &amp;nbsp;|&amp;nbsp; T8 = UART TX&lt;br&gt;T9 = GND (Relay + CFG) &amp;nbsp;|&amp;nbsp; T10 = UART RX&lt;br&gt;T11 = Relay CH1 (Pump)&lt;br&gt;T13 = Relay CH2 (Gimbal) &amp;nbsp;|&amp;nbsp; T14 = UART GND&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;align=left;spacingLeft=10;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="545" y="295" width="230" height="110" as="geometry"/></mxCell>

        <!-- DEVICE: Relay Module -->
        <mxCell id="relay" value="" style="rounded=1;fillColor=#4A148C;strokeColor=#7B1FA2;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="850" y="140" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="relayic" value="" style="rounded=0;fillColor=#111;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="25" height="20" as="geometry"/></mxCell>
        <mxCell id="relayled" value="" style="ellipse;fillColor=#F44336;strokeColor=#D32F2F;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="905" y="162" width="7" height="7" as="geometry"/></mxCell>
        <mxCell id="relayterm" value="" style="rounded=0;fillColor=#2E7D32;strokeColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="870" y="195" width="140" height="14" as="geometry"/></mxCell>
        <mxCell id="relaylbl" value="&lt;b style='color:#CE93D8;font-size:11px'&gt;Monk Makes Relay&lt;/b&gt;&lt;br&gt;&lt;span style='color:#9C27B0;font-size:8px'&gt;5V from T2 | GND from T9&lt;br&gt;CH1=T11 (Pump) | CH2=T13 (Gimbal)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="212" width="160" height="35" as="geometry"/></mxCell>

