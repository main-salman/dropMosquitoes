        <mxCell id="ribbonl" value="&lt;b style='color:#333;font-size:11px'&gt;40-Pin F/F IDC Ribbon Cable&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666;font-size:9px'&gt;0.3m, 2.54mm pitch — routes through chassis slot&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="310" y="130" width="220" height="30" as="geometry"/></mxCell>
        <!-- Rainbow stripe detail on cable -->
        <mxCell id="rstr1" value="" style="rounded=0;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="188" width="200" height="2" as="geometry"/></mxCell>
        <mxCell id="rstr2" value="" style="rounded=0;fillColor=#FF9800;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="191" width="200" height="2" as="geometry"/></mxCell>
        <mxCell id="rstr3" value="" style="rounded=0;fillColor=#FBC02D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="194" width="200" height="2" as="geometry"/></mxCell>
        <mxCell id="rstr4" value="" style="rounded=0;fillColor=#4CAF50;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="197" width="200" height="2" as="geometry"/></mxCell>
        <mxCell id="rstr5" value="" style="rounded=0;fillColor=#2196F3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="200" width="200" height="2" as="geometry"/></mxCell>

        <!-- ZONE: Inside IP67 Enclosure -->
        <mxCell id="zone2" value="" style="rounded=1;fillColor=#F1F8E9;strokeColor=#4CAF50;strokeWidth=3;dashed=0;arcSize=4;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="560" height="590" as="geometry"/></mxCell>
        <mxCell id="zone2l" value="&lt;b style='color:#2E7D32;font-size:12px'&gt;INSIDE IP67 ENCLOSURE — EXTERNAL TERMINAL HUB&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4CAF50;font-size:9px'&gt;All field wiring happens here — Yahboom case stays sealed&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="85" width="440" height="28" as="geometry"/></mxCell>

