<mxfile>
  <diagram name="Terminal Block Hub" id="termblock_v1">
    <mxGraphModel dx="1600" dy="1000" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b style='font-size:18px;color:#333'&gt;ECO-2026-002: External Terminal Block Hub&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Jetson GPIO → Ribbon Cable → IDC40P Breakout → All Device Wiring&lt;/span&gt;" style="text;html=1;fontSize=14;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="700" height="50" as="geometry"/></mxCell>

        <!-- ZONE: Inside Yahboom Case -->
        <mxCell id="zone1" value="" style="rounded=1;fillColor=#FAFAFA;strokeColor=#263238;strokeWidth=3;dashed=1;dashPattern=10 5;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="340" height="330" as="geometry"/></mxCell>
        <mxCell id="zone1l" value="&lt;b style='color:#263238;font-size:12px'&gt;INSIDE YAHBOOM CASE&lt;/b&gt;&lt;br&gt;&lt;span style='color:#78909C;font-size:9px'&gt;Sealed shut after ribbon cable exit&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="85" width="240" height="28" as="geometry"/></mxCell>

        <!-- Jetson inside Yahboom -->
