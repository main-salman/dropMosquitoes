        <mxCell id="idclbl" value="&lt;b style='color:#A5D6A7;font-size:14px'&gt;IDC40P Terminal Block&lt;/b&gt;&lt;br&gt;&lt;span style='color:#81C784;font-size:9px'&gt;Screw terminal breakout board&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="590" y="152" width="180" height="28" as="geometry"/></mxCell>

