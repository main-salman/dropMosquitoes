        <mxCell id="w3l" value="&lt;span style='color:#388E3C;font-size:9px'&gt;&lt;b&gt;T8,T10,T14&lt;/b&gt;&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="795" y="380" width="60" height="14" as="geometry"/></mxCell>

        <!-- Key insight callout -->
        <mxCell id="key" value="&lt;b&gt;✅ KEY INSIGHT:&lt;/b&gt; Terminal numbers = physical pin numbers (1:1 mapping).&lt;br&gt;Screw Terminal 11 = Jetson Pin 11 = BCM 17 = Relay CH1 (Pump)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="440" height="40" as="geometry"/></mxCell>
        <mxCell id="warn" value="⚠ &lt;b&gt;RULE:&lt;/b&gt; NEVER wire directly to Jetson GPIO header. ALL connections go to IDC40P screw terminals." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6D00;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="440" height="35" as="geometry"/></mxCell>
