        <mxCell id="lidarlbl" value="&lt;b style='color:#4DD0E1;font-size:11px'&gt;TF-Luna LiDAR&lt;/b&gt;&lt;br&gt;&lt;span style='color:#00BCD4;font-size:8px'&gt;SDA=T3 | SCL=T5 | 5V=T4&lt;br&gt;GND=T6 | CFG→T9 (GND)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="330" width="160" height="35" as="geometry"/></mxCell>

        <!-- DEVICE: Storm32 -->
