        <mxCell id="st2l" value="&lt;span style='font-size:7px;color:#FFF'&gt;T2(5V) T3(SDA) T4(5V) T5(SCL) T6(GND)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="195" width="170" height="13" as="geometry"/></mxCell>
        <mxCell id="st3" value="" style="rounded=0;fillColor=#4CAF50;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="170" height="14" as="geometry"/></mxCell>
        <mxCell id="st3l" value="&lt;span style='font-size:7px;color:#FFF'&gt;T8(TX) T9(GND) T10(RX) T11(CH1) T13(CH2)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="170" height="13" as="geometry"/></mxCell>
