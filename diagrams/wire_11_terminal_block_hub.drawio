        <mxCell id="jetcap" value="&lt;span style='color:#78909C;font-size:9px'&gt;Yahboom Aluminum Case&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="260" width="150" height="14" as="geometry"/></mxCell>
