        <mxCell id="glandcap" value="&lt;b&gt;3. Cable Gland&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;enclosure entry&lt;/span&gt;" style="text;html=1;fontSize=10;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="495" y="240" width="90" height="28" as="geometry"/></mxCell>
        <!-- Service Loop -->
