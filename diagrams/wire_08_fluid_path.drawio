        <mxCell id="pumplbl" value="&lt;span style='color:#90CAF9;font-size:8px'&gt;&lt;b&gt;Velleman 12V&lt;/b&gt;&lt;br&gt;Submerged&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="60" height="22" as="geometry"/></mxCell>
        <mxCell id="rescap" value="&lt;b&gt;1. Reservoir + Pump&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;pump sits inside water&lt;/span&gt;" style="text;html=1;fontSize=10;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="140" height="28" as="geometry"/></mxCell>
