        <mxCell id="valvearrow" value="&lt;span style='font-size:20px;color:#3F51B5'&gt;▶&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="145" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="valvebody" value="" style="rounded=0;fillColor=#7986CB;strokeColor=#5C6BC0;" vertex="1" parent="1"><mxGeometry x="275" y="165" width="70" height="12" as="geometry"/></mxCell>
        <mxCell id="valvelbl" value="&lt;span style='color:#3F51B5;font-size:8px'&gt;&lt;b&gt;PVDF Check Valve&lt;/b&gt;&lt;br&gt;Prevents siphon&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="265" y="180" width="90" height="22" as="geometry"/></mxCell>
        <mxCell id="valvecap" value="&lt;b&gt;2. Check Valve&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;1/4&amp;quot; inline, one-way&lt;/span&gt;" style="text;html=1;fontSize=10;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="255" y="240" width="110" height="28" as="geometry"/></mxCell>
