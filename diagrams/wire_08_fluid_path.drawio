<mxfile>
  <diagram name="Fluid Path" id="fluid_v2">
    <mxGraphModel dx="1600" dy="800" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;WIRE 08: Fluid Path&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Reservoir → Pump → Check Valve → Tubing → Service Loop → Nozzle&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="700" height="45" as="geometry"/></mxCell>
        <!-- Reservoir -->
        <mxCell id="res" value="" style="rounded=1;fillColor=#E3F2FD;strokeColor=#90CAF9;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="140" height="120" as="geometry"/></mxCell>
        <mxCell id="reswater" value="" style="rounded=0;fillColor=#42A5F5;strokeColor=#1E88E5;opacity=50;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="120" height="75" as="geometry"/></mxCell>
        <mxCell id="reslbl" value="&lt;b style='color:#1565C0;font-size:11px'&gt;Water Reservoir&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1976D2;font-size:8px'&gt;Shallow tote + mesh lid&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="120" height="28" as="geometry"/></mxCell>
        <!-- Pump (submerged) -->
