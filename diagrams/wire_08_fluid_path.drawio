        <mxCell id="sloop" value="&lt;span style='font-size:8px;color:#42A5F5'&gt;3&amp;quot; service loop&lt;br&gt;(slack for gimbal)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="218" width="80" height="22" as="geometry"/></mxCell>
        <!-- Nozzle -->
