        <mxCell id="clampl" value="&lt;span style='font-size:7px;color:#666'&gt;clamp&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="438" y="183" width="28" height="10" as="geometry"/></mxCell>
