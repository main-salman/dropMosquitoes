        <mxCell id="nozzletip" value="" style="triangle;fillColor=#4CAF50;strokeColor=#2E7D32;direction=east;" vertex="1" parent="1"><mxGeometry x="780" y="155" width="30" height="20" as="geometry"/></mxCell>
        <mxCell id="nozzlebody" value="" style="rounded=0;fillColor=#2E7D32;strokeColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="60" height="12" as="geometry"/></mxCell>
        <mxCell id="nozzlelbl" value="&lt;span style='color:#A5D6A7;font-size:9px'&gt;&lt;b&gt;Orbit 66190&lt;/b&gt;&lt;br&gt;Flex-Mist Nozzle&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="135" width="100" height="22" as="geometry"/></mxCell>
        <mxCell id="spray" value="&lt;span style='font-size:16px;color:#42A5F5'&gt;💧&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="810" y="148" width="25" height="25" as="geometry"/></mxCell>
        <mxCell id="nozzlecap" value="&lt;b&gt;4. Nozzle&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;adjustable narrow stream&lt;/span&gt;" style="text;html=1;fontSize=10;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="240" width="120" height="28" as="geometry"/></mxCell>
        <mxCell id="flow" value="&lt;b&gt;Flow Direction:&lt;/b&gt; Reservoir → Pump pressurizes → Check valve prevents backflow → Tubing runs up pole → Service loop absorbs gimbal rotation → Nozzle fires downward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#2196F3;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="780" height="35" as="geometry"/></mxCell>
