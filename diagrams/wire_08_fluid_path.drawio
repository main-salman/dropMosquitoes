        <mxCell id="tube2l" value="&lt;span style='font-size:8px;color:#42A5F5'&gt;up pole (8-10ft)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="385" y="155" width="80" height="14" as="geometry"/></mxCell>
        <!-- Hose Clamp -->
