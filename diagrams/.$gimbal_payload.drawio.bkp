<mxfile host="app.diagrams.net">
  <diagram name="Gimbal Payload Detail" id="gp">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="GIMBAL PAYLOAD DETAIL — Storm32 Moving Assembly (Front Face View)" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="10" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="leg" value="── Solid = FASTEN   - - Blue Dashed = FLUID   - - Purple Dashed = FPC   ▓ = Zip Tie" style="text;html=1;fontSize=9;fontStyle=2;fillColor=#FFFFCC;strokeColor=#CC0;rounded=1;" vertex="1" parent="1"><mxGeometry x="100" y="45" width="550" height="22" as="geometry"/></mxCell>

        <mxCell id="note_fixed" value="⚠️ The Scout camera (OV9281) is NOT here.&#xa;It is fixed to the post/enclosure for wide-angle detection." style="rounded=1;fillColor=#FFCC00;strokeColor=#CC9900;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="380" height="35" as="geometry"/></mxCell>

        <!-- Gimbal frame -->
        <mxCell id="frame" value="" style="rounded=1;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1300" height="700" as="geometry"/></mxCell>
        <mxCell id="frame_lbl" value="Storm32 CNC Metal Gimbal — Payload Plate" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="400" y="135" width="500" height="20" as="geometry"/></mxCell>

        <!-- Pitch motor -->
        <mxCell id="pitch" value="PITCH&#xa;Motor&#xa;(±45°)" style="ellipse;fillColor=#B0BEC5;strokeColor=#607D8B;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="70" height="70" as="geometry"/></mxCell>
        <!-- Yaw motor -->
        <mxCell id="yaw" value="YAW Motor (±130°)" style="rounded=0;fillColor=#B0BEC5;strokeColor=#607D8B;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="500" y="770" width="300" height="40" as="geometry"/></mxCell>

        <!-- ① Sniper Camera -->
        <mxCell id="sniper" value="📷 Arducam NoIR IMX219&#xa;8MP Motorized IR-Cut&#xa;(THE SNIPER)&#xa;&#xa;Lens faces FORWARD →" style="rounded=1;fillColor=#F48FB1;strokeColor=#E91E63;fontStyle=1;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="160" y="200" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="b1" value="①" style="ellipse;fillColor=#FF6600;strokeColor=#CC3300;fontStyle=1;fontSize=16;fontColor=#FFF;" vertex="1" parent="1"><mxGeometry x="150" y="190" width="35" height="35" as="geometry"/></mxCell>
        <mxCell id="b1n" value="① FASTEN: IMX219 camera to&#xa;payload plate via 4x M2 bolts.&#xa;Lens orientation: FORWARD." style="text;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1"><mxGeometry x="160" y="360" width="250" height="45" as="geometry"/></mxCell>

        <!-- ② Orbit Nozzle -->
        <mxCell id="nozzle" value="💦 Orbit Flex-Mist&#xa;Adjustable Nozzle&#xa;10-32 MT Thread&#xa;&#xa;Spray axis ↑ aligned&#xa;with camera FOV" style="rounded=1;fillColor=#2196F3;strokeColor=#0D47A1;fontStyle=1;fontSize=11;fontColor=#FFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="200" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="b2" value="②" style="ellipse;fillColor=#FF6600;strokeColor=#CC3300;fontStyle=1;fontSize=16;fontColor=#FFF;" vertex="1" parent="1"><mxGeometry x="570" y="190" width="35" height="35" as="geometry"/></mxCell>
        <mxCell id="b2n" value="② FASTEN: Nozzle bolted adjacent&#xa;to camera. Spray axis parallel to&#xa;camera FOV. Use Loctite on thread." style="text;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="280" height="45" as="geometry"/></mxCell>

        <!-- ③ Tubing service loop -->
        <mxCell id="loop_line" value="" style="curved=1;endArrow=none;strokeColor=#0099DD;strokeWidth=5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="200" as="sourcePoint"/><Array as="points"><mxPoint x="730" y="160"/><mxPoint x="900" y="140"/><mxPoint x="1100" y="150"/></Array><mxPoint x="1200" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="loop_lbl" value="1/4&quot; ID Silicone Tubing&#xa;SERVICE LOOP — 3&quot; slack arc" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#0066CC;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="240" height="30" as="geometry"/></mxCell>
        <mxCell id="b3" value="③" style="ellipse;fillColor=#FF6600;strokeColor=#CC3300;fontStyle=1;fontSize=16;fontColor=#FFF;" vertex="1" parent="1"><mxGeometry x="950" y="105" width="35" height="35" as="geometry"/></mxCell>
        <mxCell id="z1" value="▓ ZIP" style="rounded=0;fillColor=#333;strokeColor=#000;fontSize=7;fontColor=#FFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="145" width="40" height="14" as="geometry"/></mxCell>
        <mxCell id="z2" value="▓ ZIP" style="rounded=0;fillColor=#333;strokeColor=#000;fontSize=7;fontColor=#FFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="145" width="40" height="14" as="geometry"/></mxCell>
        <mxCell id="b3n" value="③ ROUTE: Tubing with 3&quot; service loop.&#xa;Secure with 4-inch zip ties at 2 anchors.&#xa;Loop allows ±130° yaw without kinking." style="text;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1"><mxGeometry x="940" y="200" width="300" height="45" as="geometry"/></mxCell>
        <mxCell id="to_enc" value="→ Tubing routes to&#xa;IP67 Gland PG11 →&#xa;down to Reservoir" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#0066CC;" vertex="1" parent="1"><mxGeometry x="1200" y="160" width="140" height="45" as="geometry"/></mxCell>

        <!-- ④ CSI-HDMI RX + FPC Strain Relief -->
        <mxCell id="rx_board" value="CSI→HDMI RX Board&#xa;(Sniper chain)" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="200" y="450" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="fpc_cam" value="15-pin FPC" style="strokeColor=#9933CC;strokeWidth=2;dashed=1;endArrow=block;" edge="1" source="sniper" target="rx_board" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="strain" value="FPC STRAIN RELIEF&#xa;ANCHOR BLOCK" style="rounded=0;fillColor=#FFE0B2;strokeColor=#E65100;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="200" y="540" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="b4" value="④" style="ellipse;fillColor=#FF6600;strokeColor=#CC3300;fontStyle=1;fontSize=16;fontColor=#FFF;" vertex="1" parent="1"><mxGeometry x="190" y="530" width="35" height="35" as="geometry"/></mxCell>
        <mxCell id="z3" value="▓ ZIP" style="rounded=0;fillColor=#333;strokeColor=#000;fontSize=7;fontColor=#FFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="585" width="40" height="14" as="geometry"/></mxCell>
        <mxCell id="z4" value="▓ ZIP" style="rounded=0;fillColor=#333;strokeColor=#000;fontSize=7;fontColor=#FFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="585" width="40" height="14" as="geometry"/></mxCell>
        <mxCell id="fpc_out" style="strokeColor=#9933CC;strokeWidth=2;dashed=1;endArrow=open;" edge="1" source="rx_board" target="strain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b4n" value="④ FPC FIREWALL — STRAIN RELIEF:&#xa;FPC ribbon from camera → RX board is&#xa;zip-tied to this anchor with foam pad.&#xa;HDMI cable exits from here → IP67 box.&#xa;Prevents snap during Death Spiral." style="text;html=1;fontSize=9;fillColor=#FFE0B2;strokeColor=#E65100;rounded=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="610" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="hdmi_exit" value="→ HDMI Cable exits here&#xa;→ Routes to IP67 Gland PG13.5&#xa;→ Connects to TX Board inside" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="430" y="545" width="230" height="45" as="geometry"/></mxCell>

        <!-- Storm32 board location -->
        <mxCell id="storm32" value="⚡ Storm32 BGC Controller&#xa;(mounted on gimbal frame)" style="rounded=1;fillColor=#CE93D8;strokeColor=#7B1FA2;fontStyle=1;fontSize=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="500" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="storm_note" value="UART TX/RX from Jetson&#xa;+12V from Relay CH2 NO&#xa;GND from Wago Port 5" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="720" y="570" width="200" height="40" as="geometry"/></mxCell>

        <!-- Death spiral warning -->
        <mxCell id="warn" value="⚠️ DEATH SPIRAL CLEARANCE:&#xa;ALL cables and tubing exiting the&#xa;gimbal MUST have ≥3&quot; slack loop&#xa;to survive full ±130° yaw + ±45° pitch." style="rounded=1;fillColor=#FF0000;strokeColor=#CC0000;fontStyle=1;fontSize=10;fontColor=#FFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="650" width="350" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
