        <mxCell id="pump_motor" value="" style="ellipse;fillColor=#1565C0;strokeColor=#1976D2;" vertex="1" parent="1"><mxGeometry x="715" y="115" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="pump_shaft" value="" style="ellipse;fillColor=#CFB53B;strokeColor=#B8860B;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="738" y="138" width="14" height="14" as="geometry"/></mxCell>
