        <mxCell id="gpio_cap" value="&lt;b&gt;Jetson Orin Nano&lt;/b&gt;&lt;br&gt;&lt;span style='color:#888;font-size:10px'&gt;40-pin GPIO header&lt;/span&gt;" style="text;html=1;fontSize=11;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="305" width="180" height="30" as="geometry"/></mxCell>

