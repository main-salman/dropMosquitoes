        <!-- YELLOW: GPIO 18 → Relay SIG -->
        <mxCell id="c1" value="" style="endArrow=block;endFill=1;strokeColor=#FBC02D;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="180" as="sourcePoint"/><mxPoint x="390" y="215" as="targetPoint"/><Array as="points"><mxPoint x="290" y="180"/><mxPoint x="290" y="215"/></Array></mxGeometry></mxCell>
        <mxCell id="c1l" value="&lt;span style='color:#F9A825;font-size:10px'&gt;&lt;b&gt;YELLOW&lt;/b&gt; Pin 11 → SIG&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="162" width="130" height="16" as="geometry"/></mxCell>

        <!-- BLACK: GND → Relay GND -->
        <mxCell id="c2" value="" style="endArrow=block;endFill=1;strokeColor=#555;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="215" as="sourcePoint"/><mxPoint x="425" y="215" as="targetPoint"/><Array as="points"><mxPoint x="310" y="215"/></Array></mxGeometry></mxCell>
        <mxCell id="c2l" value="&lt;span style='color:#555;font-size:10px'&gt;&lt;b&gt;BLACK&lt;/b&gt; Pin 6 → GND&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="218" width="130" height="16" as="geometry"/></mxCell>

        <!-- RED: Wago +12V → Relay COM -->
        <mxCell id="c3" value="" style="endArrow=block;endFill=1;strokeColor=#D32F2F;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="380" as="sourcePoint"/><mxPoint x="495" y="225" as="targetPoint"/><Array as="points"><mxPoint x="460" y="340"/><mxPoint x="495" y="340"/></Array></mxGeometry></mxCell>
        <mxCell id="c3l" value="&lt;span style='color:#D32F2F;font-size:10px'&gt;&lt;b&gt;RED&lt;/b&gt; Wago +12V → COM&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="355" width="140" height="16" as="geometry"/></mxCell>
        <mxCell id="wago_ref" value="&lt;span style='font-size:9px;color:#FF6D00'&gt;From Wago +12V Port 4&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="120" height="16" as="geometry"/></mxCell>

        <!-- RED: Relay NO → Pump + terminal -->
        <mxCell id="c4" value="" style="endArrow=block;endFill=1;strokeColor=#D32F2F;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535" y="215" as="sourcePoint"/><mxPoint x="735" y="200" as="targetPoint"/><Array as="points"><mxPoint x="640" y="215"/><mxPoint x="640" y="200"/></Array></mxGeometry></mxCell>
        <mxCell id="c4l" value="&lt;span style='color:#D32F2F;font-size:10px'&gt;&lt;b&gt;RED&lt;/b&gt; NO → Pump +&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="590" y="198" width="120" height="16" as="geometry"/></mxCell>

        <!-- BLACK: Pump - → Wago GND -->
        <mxCell id="c5" value="" style="endArrow=block;endFill=1;strokeColor=#555;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="200" as="sourcePoint"/><mxPoint x="880" y="400" as="targetPoint"/><Array as="points"><mxPoint x="880" y="200"/></Array></mxGeometry></mxCell>
        <mxCell id="c5l" value="&lt;span style='color:#555;font-size:10px'&gt;&lt;b&gt;BLACK&lt;/b&gt; Pump − → Wago GND&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="840" y="285" width="140" height="16" as="geometry"/></mxCell>
        <mxCell id="wago_gnd_ref" value="&lt;span style='font-size:9px;color:#FF6D00'&gt;To Wago GND Port 4&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="400" width="120" height="16" as="geometry"/></mxCell>

        <!-- Diode connections (dashed - parallel with pump) -->
        <mxCell id="d1" value="" style="endArrow=none;strokeColor=#F44336;strokeWidth=2;dashed=1;dashPattern=6 3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="310" as="sourcePoint"/><mxPoint x="880" y="310" as="targetPoint"/><Array as="points"><mxPoint x="880" y="310"/></Array></mxGeometry></mxCell>
        <mxCell id="d2" value="" style="endArrow=none;strokeColor=#F44336;strokeWidth=2;dashed=1;dashPattern=6 3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="310" as="sourcePoint"/><mxPoint x="640" y="310" as="targetPoint"/><Array as="points"><mxPoint x="640" y="310"/></Array></mxGeometry></mxCell>

        <!-- CRITICAL callout -->
        <mxCell id="warn" value="⚠ &lt;b&gt;CRITICAL — ECO-2026-001&lt;/b&gt;&lt;br&gt;&lt;br&gt;The 12V pump is an &lt;b&gt;inductive load&lt;/b&gt;. When the relay MOSFET opens, the collapsing magnetic field generates a &lt;b&gt;destructive flyback spike&lt;/b&gt; exceeding the relay's 16V tolerance.&lt;br&gt;&lt;br&gt;The 1N4007 diode (wired &lt;b&gt;reverse-biased&lt;/b&gt; across the pump) shorts this spike safely through the diode instead of through the relay.&lt;br&gt;&lt;br&gt;&lt;b&gt;Installation:&lt;/b&gt; Solder directly to pump terminals OR insert into shared Wago ports." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6D00;fontColor=#333;fontSize=11;align=left;spacingLeft=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="600" height="160" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
