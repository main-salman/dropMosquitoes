        <mxCell id="pin_row5" value="" style="rounded=0;fillColor=#CFB53B;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="60" y="148" width="6" height="6" as="geometry"/></mxCell>
        <mxCell id="pin_row6" value="" style="rounded=0;fillColor=#CFB53B;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="74" y="148" width="6" height="6" as="geometry"/></mxCell>
        <!-- GPIO Labels -->
        <mxCell id="gpio_title" value="&lt;b style='color:#4CAF50;font-size:12px'&gt;Jetson GPIO Header&lt;/b&gt;" style="text;html=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="160" height="15" as="geometry"/></mxCell>
