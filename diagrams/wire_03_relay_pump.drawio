        <!-- Realistic 2x20 pin header block -->
        <mxCell id="gpio_body" value="" style="rounded=0;fillColor=#1B1B1B;strokeColor=#333;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="200" as="geometry"/></mxCell>
        <!-- Pin rows (gold rectangles representing pins) -->
        <mxCell id="pin_row1" value="" style="rounded=0;fillColor=#CFB53B;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="6" height="6" as="geometry"/></mxCell>
        <mxCell id="pin_row2" value="" style="rounded=0;fillColor=#CFB53B;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="74" y="120" width="6" height="6" as="geometry"/></mxCell>
