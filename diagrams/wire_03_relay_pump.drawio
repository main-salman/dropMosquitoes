        <mxCell id="pump_outlet_lbl" value="&lt;span style='font-size:8px;color:#1565C0'&gt;1/4&amp;quot; barb&lt;br&gt;outlet&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="112" width="40" height="25" as="geometry"/></mxCell>
