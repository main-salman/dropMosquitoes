        <mxCell id="relay_cap" value="&lt;b&gt;Monk Makes Relay (CH1)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#888;font-size:10px'&gt;Solid-state, opto-isolated, 16V max&lt;/span&gt;" style="text;html=1;fontSize=11;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="305" width="220" height="30" as="geometry"/></mxCell>

