        <mxCell id="diode_body" value="" style="rounded=1;fillColor=#1a1a1a;strokeColor=#333;arcSize=30;" vertex="1" parent="1"><mxGeometry x="730" y="300" width="60" height="20" as="geometry"/></mxCell>
        <!-- Cathode band (silver stripe) -->
        <mxCell id="diode_band" value="" style="rounded=0;fillColor=#BDBDBD;strokeColor=#999;" vertex="1" parent="1"><mxGeometry x="779" y="300" width="8" height="20" as="geometry"/></mxCell>
        <mxCell id="diode_lead_r" value="" style="endArrow=none;strokeColor=#999;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="310" as="sourcePoint"/><mxPoint x="830" y="310" as="targetPoint"/></mxGeometry></mxCell>
        <!-- Diode labels -->
        <mxCell id="diode_k" value="&lt;span style='font-size:8px;color:#666'&gt;&lt;b&gt;K&lt;/b&gt; (Cathode)&lt;br&gt;→ +12V&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="795" y="275" width="55" height="25" as="geometry"/></mxCell>
        <mxCell id="diode_a" value="&lt;span style='font-size:8px;color:#666'&gt;&lt;b&gt;A&lt;/b&gt; (Anode)&lt;br&gt;→ GND&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="275" width="50" height="25" as="geometry"/></mxCell>
        <mxCell id="diode_cap" value="&lt;b&gt;1N4007 Flyback Diode&lt;/b&gt;&lt;br&gt;&lt;span style='color:#F44336;font-size:10px'&gt;⚠ REVERSE-BIASED across pump&lt;/span&gt;" style="text;html=1;fontSize=11;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="325" width="180" height="30" as="geometry"/></mxCell>

