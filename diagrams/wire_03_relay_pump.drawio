<mxfile>
  <diagram name="Relay to Pump + Flyback Diode" id="relay1_v2">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;WIRE DIAGRAM 03: Relay → Pump + Flyback Diode&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;GPIO BCM 17 (Pin 11) triggers relay CH1 → 12V diaphragm pump fires → 1N4007 absorbs flyback spike&lt;/span&gt;" style="text;html=1;fontSize=14;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="800" height="50" as="geometry"/></mxCell>

