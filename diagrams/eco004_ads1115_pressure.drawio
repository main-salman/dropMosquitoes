        <mxCell id="ptlbl" value="&lt;b style='color:#CFD8DC;font-size:12px'&gt;AUTEX Pressure&lt;br&gt;Transducer&lt;/b&gt;&lt;br&gt;&lt;span style='color:#90A4AE;font-size:9px'&gt;0–100 PSI · 1/8&quot;-27 NPT&lt;br&gt;5V in → 0.5–4.5V out&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="128" y="470" width="115" height="72" as="geometry"/></mxCell>
        <mxCell id="ptpins" value="&lt;span style='font-size:10px;color:#FFF'&gt;&lt;b style='color:#EF5350'&gt;+5V&lt;/b&gt; (red)&amp;nbsp;&amp;nbsp; &lt;b style='color:#BDBDBD'&gt;GND&lt;/b&gt; (blk)&amp;nbsp;&amp;nbsp; &lt;b style='color:#AED581'&gt;SIG&lt;/b&gt; (grn)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="45" y="580" width="200" height="16" as="geometry"/></mxCell>
        <mxCell id="ptcap" value="&lt;span style='color:#888;font-size:10px'&gt;Screws into the brass tee on the accumulator/solenoid line&lt;/span&gt;" style="text;html=1;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="230" height="18" as="geometry"/></mxCell>

