        <mxCell id="adslbl" value="&lt;b style='color:#90CAF9;font-size:14px'&gt;ADS1115&lt;/b&gt;&lt;br&gt;&lt;span style='color:#64B5F6;font-size:10px'&gt;16-bit 4-ch I2C ADC + PGA&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="adsL" value="" style="rounded=0;fillColor=#1565C0;strokeColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="560" y="145" width="16" height="150" as="geometry"/></mxCell>
