        <mxCell id="adsGND" value="&lt;span style='font-size:10px;color:#FFF'&gt;&lt;b style='color:#BDBDBD'&gt;GND&lt;/b&gt; → common&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="580" y="174" width="150" height="16" as="geometry"/></mxCell>
