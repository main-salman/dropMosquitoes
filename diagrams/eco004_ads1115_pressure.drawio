        <mxCell id="adsALRT" value="&lt;span style='font-size:10px;color:#999'&gt;ALRT/RDY — n/c&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="580" y="278" width="150" height="16" as="geometry"/></mxCell>
        <mxCell id="adsR" value="" style="rounded=0;fillColor=#1565C0;strokeColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="784" y="145" width="16" height="120" as="geometry"/></mxCell>
        <mxCell id="adsA0" value="&lt;span style='font-size:10px;color:#FFF'&gt;A0 ← tap&lt;b style='color:#AED581'&gt; (in)&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=right;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="644" y="148" width="136" height="16" as="geometry"/></mxCell>
        <mxCell id="adsA1" value="&lt;span style='font-size:10px;color:#999'&gt;A1 — spare&lt;/span&gt;" style="text;html=1;align=right;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="644" y="174" width="136" height="16" as="geometry"/></mxCell>
        <mxCell id="adsA2" value="&lt;span style='font-size:10px;color:#999'&gt;A2 — spare&lt;/span&gt;" style="text;html=1;align=right;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="644" y="200" width="136" height="16" as="geometry"/></mxCell>
