        <mxCell id="wi3" value="" style="endArrow=none;strokeColor=#455A64;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="614" as="sourcePoint"/><mxPoint x="410" y="632" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wi4" value="" style="endArrow=none;strokeColor=#455A64;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="674" as="sourcePoint"/><mxPoint x="410" y="694" as="targetPoint"/></mxGeometry></mxCell>

        <!-- ===== Transducer power/ground wires ===== -->
        <!-- +5V excite -> T4 -->
        <mxCell id="w5v" value="" style="endArrow=block;endFill=1;strokeColor=#E53935;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="605" as="sourcePoint"/><mxPoint x="40" y="236" as="targetPoint"/><Array as="points"><mxPoint x="90" y="638"/><mxPoint x="18" y="638"/><mxPoint x="18" y="236"/></Array></mxGeometry></mxCell>
        <mxCell id="w5vl" value="&lt;span style='color:#C62828;font-size:9px'&gt;&lt;b&gt;+5V&lt;/b&gt; (red)&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="345" width="70" height="14" as="geometry"/></mxCell>
        <!-- transducer GND -> T6 -->
        <mxCell id="wgt" value="" style="endArrow=block;endFill=1;strokeColor=#616161;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="605" as="sourcePoint"/><mxPoint x="40" y="266" as="targetPoint"/><Array as="points"><mxPoint x="150" y="655"/><mxPoint x="8" y="655"/><mxPoint x="8" y="266"/></Array></mxGeometry></mxCell>
        <mxCell id="wgtl" value="&lt;span style='color:#424242;font-size:9px'&gt;&lt;b&gt;GND&lt;/b&gt; (blk)&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="70" height="14" as="geometry"/></mxCell>

        <!-- ===== SIG (transducer) -> Wago #1 ===== -->
        <mxCell id="wsig" value="" style="endArrow=block;endFill=1;strokeColor=#7CB342;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="605" as="sourcePoint"/><mxPoint x="330" y="458" as="targetPoint"/><Array as="points"><mxPoint x="285" y="605"/><mxPoint x="285" y="458"/></Array></mxGeometry></mxCell>
        <mxCell id="wsigl" value="&lt;span style='color:#558B2F;font-size:9px'&gt;&lt;b&gt;SIG&lt;/b&gt; 0.5–4.5V (green)&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="222" y="560" width="130" height="14" as="geometry"/></mxCell>

        <!-- ===== TAP (Wago #2 P3) -> ADS1115 A0 ===== -->
        <mxCell id="wtap" value="" style="endArrow=block;endFill=1;strokeColor=#AED581;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="589" as="sourcePoint"/><mxPoint x="800" y="163" as="targetPoint"/><Array as="points"><mxPoint x="835" y="589"/><mxPoint x="835" y="163"/></Array></mxGeometry></mxCell>
        <mxCell id="wtapl" value="&lt;span style='color:#689F38;font-size:9px'&gt;&lt;b&gt;tap&lt;/b&gt; 0.34–3.09V → A0&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="360" width="160" height="14" as="geometry"/></mxCell>

        <!-- ===== GND (Wago #3 P2) -> T6 common ===== -->
        <mxCell id="wg3" value="" style="endArrow=block;endFill=1;strokeColor=#616161;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="716" as="sourcePoint"/><mxPoint x="250" y="266" as="targetPoint"/><Array as="points"><mxPoint x="272" y="716"/><mxPoint x="272" y="266"/></Array></mxGeometry></mxCell>
        <mxCell id="wg3l" value="&lt;span style='color:#424242;font-size:9px'&gt;&lt;b&gt;GND&lt;/b&gt; → T6 (common)&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="276" y="410" width="120" height="14" as="geometry"/></mxCell>

        <!-- ===== ADS1115 <-> terminal (power + I2C) ===== -->
        <mxCell id="wVDD" value="" style="endArrow=block;endFill=1;strokeColor=#FF7043;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="146" as="sourcePoint"/><mxPoint x="560" y="156" as="targetPoint"/><Array as="points"><mxPoint x="470" y="146"/><mxPoint x="470" y="156"/></Array></mxGeometry></mxCell>
        <mxCell id="wVDDl" value="&lt;span style='color:#E64A19;font-size:9px'&gt;&lt;b&gt;3.3V&lt;/b&gt; → VDD&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="128" width="90" height="14" as="geometry"/></mxCell>
        <mxCell id="wSDA" value="" style="endArrow=block;endFill=1;strokeColor=#2196F3;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="176" as="sourcePoint"/><mxPoint x="560" y="234" as="targetPoint"/><Array as="points"><mxPoint x="440" y="176"/><mxPoint x="440" y="234"/></Array></mxGeometry></mxCell>
        <mxCell id="wSDAl" value="&lt;span style='color:#1976D2;font-size:9px'&gt;&lt;b&gt;SDA&lt;/b&gt; (Pin 27)&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="90" height="14" as="geometry"/></mxCell>
        <mxCell id="wSCL" value="" style="endArrow=block;endFill=1;strokeColor=#FBC02D;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="206" as="sourcePoint"/><mxPoint x="560" y="208" as="targetPoint"/><Array as="points"><mxPoint x="420" y="206"/><mxPoint x="420" y="208"/></Array></mxGeometry></mxCell>
        <mxCell id="wSCLl" value="&lt;span style='color:#F9A825;font-size:9px'&gt;&lt;b&gt;SCL&lt;/b&gt; (Pin 28)&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="212" width="90" height="14" as="geometry"/></mxCell>

        <!-- ===== Notes ===== -->
        <mxCell id="warn" value="⚠ &lt;b&gt;POWER THE ADS1115 AT 3.3V&lt;/b&gt; (not 5V). Its onboard SDA/SCL pull-ups tie to VDD — at 5V they would over-voltage the Jetson's 3.3V I2C lines." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="95" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="conn" value="&lt;b style='color:#5D4037'&gt;Divider — exactly what connects where:&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#333'&gt;1. Transducer &lt;b&gt;SIG&lt;/b&gt; → &lt;b&gt;Wago#1&lt;/b&gt; P1.&amp;nbsp; Wago#1 P2 → one leg of &lt;b&gt;R1&lt;/b&gt;.&lt;br&gt;2. R1 other leg → &lt;b&gt;Wago#2&lt;/b&gt; P1 (the TAP).&lt;br&gt;3. One leg of &lt;b&gt;R2&lt;/b&gt; → &lt;b&gt;Wago#2&lt;/b&gt; P2.&amp;nbsp; Wago#2 P3 → &lt;b&gt;ADS1115 A0&lt;/b&gt;.&lt;br&gt;4. R2 other leg → &lt;b&gt;Wago#3&lt;/b&gt; P1.&amp;nbsp; Wago#3 P2 → &lt;b&gt;GND&lt;/b&gt; (T6/Pin 9).&lt;br&gt;&lt;br&gt;GND, ADS1115 GND and transducer GND are all the SAME net.&lt;br&gt;Each Wago port takes ONE wire/lead — flip the orange lever, insert, close.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontColor=#333;fontSize=10;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="180" width="400" height="160" as="geometry"/></mxCell>
        <mxCell id="cfg" value="&lt;b&gt;Config:&lt;/b&gt; addr &lt;b&gt;0x48&lt;/b&gt; on &lt;b&gt;I2C Bus 1&lt;/b&gt; with PCA9685/INA3221 (0x40) — 0x48 unique.&lt;br&gt;PGA = &lt;b&gt;±4.096V&lt;/b&gt; (FSR) so the 0.34–3.09V tap never clips. Single-shot on A0.&lt;br&gt;Vtap = Vsig × 22/(10+22) → &lt;b&gt;0.5V→0.34V, 4.5V→3.09V&lt;/b&gt;.&lt;br&gt;Firmware undoes it: Vsig = Vtap × 32/22;&amp;nbsp; PSI = ((Vsig − 0.5)/4.0) × 100." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#333;fontSize=10;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="355" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="eco" value="&lt;b&gt;ECO-004 (Pressure Loop):&lt;/b&gt; AUTEX transducer + brass tee + ADS1115 add measured pressure to the accumulator so charge setpoints can replace timed-only charging. Parts in parts.csv; wiring/behavior in HW-001 §7.1 / SW-001 §2.9." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#333;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1220" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
