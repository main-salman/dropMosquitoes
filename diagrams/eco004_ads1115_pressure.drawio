<mxfile>
  <diagram name="ADS1115 Pressure Sense" id="ads1115_v1">
    <mxGraphModel dx="1400" dy="900" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style='font-size:18px;color:#333'&gt;ECO-004: ADS1115 Pressure Transducer — Voltage Divider via Wago 221 Levers&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Joins I2C Bus 1 (Pin 27/28) with the PCA9685 servos + INA3221 (0x40). ADS1115 = 0x48 (unique).&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="980" height="45" as="geometry"/></mxCell>

        <!-- ===== IDC40P / Jetson Terminal Block ===== -->
        <mxCell id="idc" value="" style="rounded=1;fillColor=#1B5E20;strokeColor=#4CAF50;shadow=1;arcSize=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="210" height="255" as="geometry"/></mxCell>
        <mxCell id="idclbl" value="&lt;b style='color:#A5D6A7;font-size:12px'&gt;Jetson header / IDC40P&lt;/b&gt;&lt;br&gt;&lt;span style='color:#81C784;font-size:8px'&gt;screw-terminal breakout&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="98" width="190" height="25" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#FF8A65'&gt;Pin 1&lt;/b&gt; 3.3V &lt;span style='color:#999'&gt;(ADS VDD)&lt;/span&gt;&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="138" width="190" height="16" as="geometry"/></mxCell>
        <mxCell id="p27" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#64B5F6'&gt;Pin 27&lt;/b&gt; I2C1 SDA&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="168" width="190" height="16" as="geometry"/></mxCell>
        <mxCell id="p28" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#FDD835'&gt;Pin 28&lt;/b&gt; I2C1 SCL&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="198" width="190" height="16" as="geometry"/></mxCell>
        <mxCell id="t4" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#EF5350'&gt;T4&lt;/b&gt; 5V &lt;span style='color:#999'&gt;(transducer excite)&lt;/span&gt;&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="228" width="190" height="16" as="geometry"/></mxCell>
        <mxCell id="t6" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#BDBDBD'&gt;T6 / Pin 9&lt;/b&gt; GND &lt;span style='color:#999'&gt;(common)&lt;/span&gt;&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="258" width="190" height="16" as="geometry"/></mxCell>
        <mxCell id="idcnote" value="&lt;span style='font-size:8px;color:#C8E6C9'&gt;Pin 27/28 = Bus 1 (PCA9685 + INA3221).&lt;br&gt;&lt;b style='color:#FFAB91'&gt;Do NOT use Pin 3/5 — Gen8 bus is disabled.&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="292" width="195" height="40" as="geometry"/></mxCell>

        <!-- ===== ADS1115 Module ===== -->
