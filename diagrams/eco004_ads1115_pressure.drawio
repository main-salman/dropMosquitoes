        <mxCell id="divlbl" value="&lt;b style='color:#F57F17;font-size:13px'&gt;VOLTAGE DIVIDER&lt;/b&gt;&lt;br&gt;&lt;span style='color:#8D6E63;font-size:9px'&gt;three Wago 221 lever nuts + two resistors&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="305" y="405" width="250" height="30" as="geometry"/></mxCell>

