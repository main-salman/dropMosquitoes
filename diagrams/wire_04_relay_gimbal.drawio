<mxfile>
  <diagram name="Relay to Gimbal" id="relay2">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;WIRE DIAGRAM 04: Relay CH2 → Gimbal Power&lt;/b&gt;&lt;br&gt;GPIO 24 controls gimbal boot-delay relay" style="text;html=1;fontSize=16;fontColor=#E0E0E0;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="50" as="geometry"/></mxCell>
        <mxCell id="gpio" value="&lt;b&gt;Jetson GPIO Header&lt;/b&gt;&lt;br&gt;Pin 18 (BCM 24)&lt;br&gt;&lt;font color='#00E676'&gt;GREEN jumper wire&lt;/font&gt;&lt;br&gt;Pin 20 = GND&lt;br&gt;&lt;font color='#666'&gt;BLACK jumper wire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#4CAF50;fontColor=#FFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="rel" value="&lt;b&gt;Monk Makes Relay&lt;/b&gt;&lt;br&gt;CH2 (Gimbal Power)&lt;br&gt;&lt;hr&gt;SIG — Signal&lt;br&gt;GND — Ground&lt;br&gt;COM — Common (+12V in)&lt;br&gt;NO — Out to Gimbal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A148C;strokeColor=#9C27B0;fontColor=#FFF;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;font color='#00E676'&gt;GREEN jumper → SIG&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00E676;strokeWidth=3;fontSize=10;" edge="1" parent="1" source="gpio" target="rel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;font color='#888'&gt;BLACK jumper → GND&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555;strokeWidth=3;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="gpio" target="rel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="310"/><mxPoint x="485" y="310"/></Array></mxGeometry></mxCell>
        <mxCell id="w12" value="&lt;b&gt;Wago +12V&lt;/b&gt;&lt;br&gt;Port 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#F44336;fontColor=#FFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="340" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;font color='#F44336'&gt;RED wire → COM&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F44336;strokeWidth=4;fontSize=10;" edge="1" parent="1" source="w12" target="rel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gim" value="&lt;b&gt;Storm32 Gimbal&lt;/b&gt;&lt;br&gt;Power Input (12V)&lt;br&gt;&lt;font color='#F44336'&gt;RED = V+&lt;/font&gt;&lt;br&gt;&lt;font color='#666'&gt;BLACK = GND&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#FF9800;fontColor=#FFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="130" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="e4" value="&lt;font color='#F44336'&gt;NO → Gimbal V+&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F44336;strokeWidth=4;fontSize=10;" edge="1" parent="1" source="rel" target="gim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wgn" value="&lt;b&gt;Wago GND&lt;/b&gt;&lt;br&gt;Port 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;strokeColor=#78909C;fontColor=#FFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="340" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="e5" value="&lt;font color='#888'&gt;Gimbal GND → Wago GND&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555;strokeWidth=4;fontSize=10;" edge="1" parent="1" source="gim" target="wgn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="⚠ SAFE-001: Relay defaults OFF at boot. Gimbal gets NO power until software enables GPIO 24 HIGH." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A1C1C;strokeColor=#F44336;fontColor=#FF8A80;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="600" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
