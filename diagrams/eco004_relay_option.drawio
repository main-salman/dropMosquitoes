                <mxCell id="wire_12_ch1_l" value="&lt;b style='font-size:9px;color:#C62828'&gt;+12V → CH1/CH2 COM&lt;/b&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="378" width="150" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="wire_ch1_pump" value="" style="endArrow=block;endFill=1;strokeColor=#E53935;strokeWidth=4;rounded=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="750" y="210" as="sourcePoint"/>
                        <mxPoint x="900" y="190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
