                <mxCell id="pumpl" value="&lt;b style='color:#BBDEFB;font-size:14px'&gt;R385 Pump Motor&lt;/b&gt;&lt;br&gt;&lt;span style='color:#90CAF9;font-size:10px'&gt;(+) ← Relay CH1 NO&lt;br&gt;(−) → GND&lt;/span&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="905" y="160" width="210" height="60" as="geometry"/>
