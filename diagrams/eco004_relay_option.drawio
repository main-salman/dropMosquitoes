                    </mxGeometry>
                </mxCell>
                <mxCell id="wire_yellow_l" value="&lt;b style='font-size:10px;color:#F57F17'&gt;YELLOW (unchanged)&lt;/b&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
