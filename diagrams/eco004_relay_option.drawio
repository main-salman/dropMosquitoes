                <mxCell id="wire_12_ch1" value="" style="endArrow=block;endFill=1;strokeColor=#E53935;strokeWidth=4;rounded=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="290" y="371" as="sourcePoint"/>
                        <mxPoint x="492" y="250" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="445" y="371"/>
                            <mxPoint x="445" y="250"/>
                        </Array>
                    </mxGeometry>
