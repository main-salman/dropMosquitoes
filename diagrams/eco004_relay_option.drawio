                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="750" y="350" as="sourcePoint"/>
                        <mxPoint x="900" y="340" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="wire_ch2_sol_l" value="&lt;b style='font-size:11px;color:#E65100'&gt;★ CH2 NO → solenoid (+)&lt;/b&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="752" y="356" width="160" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="wire_pump_gnd" value="" style="endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=3;rounded=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1010" y="230" as="sourcePoint"/>
                        <mxPoint x="1010" y="640" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="wire_sol_gnd" value="" style="endArrow=block;endFill=1;strokeColor=#1E88E5;strokeWidth=4;rounded=1;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="960" y="420" as="sourcePoint"/>
                        <mxPoint x="960" y="640" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="wire_sol_gnd_l" value="&lt;b style='font-size:10px;color:#1565C0'&gt;★ MOVE BLUE: solenoid (−) → GND&lt;/b&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="965" y="470" width="200" height="18" as="geometry"/>
                </mxCell>

                <mxCell id="gndbus" value="" style="rounded=1;fillColor=#212121;strokeColor=#616161;shadow=1;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="640" width="1290" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="gndbusl" value="&lt;b style='color:#E0E0E0;font-size:12px'&gt;COMMON GND BUS — Jetson GND + 12V PSU GND + pump (−) + solenoid (−)&lt;/b&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="644" width="1290" height="22" as="geometry"/>
                </mxCell>

                <mxCell id="steps" value="&lt;b style='font-size:13px;color:#4A148C'&gt;Step-by-step: MOSFET → Relay CH2&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Power OFF (Jetson + 12V supply).&lt;br&gt;&lt;b&gt;2. REMOVE&lt;/b&gt; the MOSFET, the 4.7kΩ pull-up (and any added 1kΩ), and the wire from T17 (+3.3V). These are not used in the relay option.&lt;br&gt;&lt;b&gt;3. MOVE the GREEN wire:&lt;/b&gt; unplug it from the old MOSFET gate junction and land it on &lt;b&gt;Relay CH2 signal IN&lt;/b&gt;. (Source stays T13 / BCM 27 — same pin, no software change.)&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Run a wire from the &lt;b&gt;+12V bus → Relay CH2 COM&lt;/b&gt; (the CH1 COM may already be jumpered from +12V — daisy-chain it).&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Wire &lt;b&gt;Relay CH2 NO → Solenoid (+) RED&lt;/b&gt; (the red lead that previously went straight to +12V now lands on CH2 NO).&lt;br&gt;&lt;b&gt;6. MOVE the BLUE wire:&lt;/b&gt; solenoid (−) goes from the old MOSFET Drain to the &lt;b&gt;common GND bus&lt;/b&gt;.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Keep the &lt;b&gt;1N4007 flyback&lt;/b&gt; across the solenoid coil (band → (+) side).&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Confirm Relay Vcc←T2 (+5V) and Relay GND←T9 are still connected (shared with CH1).&lt;br&gt;&lt;br&gt;&lt;span style='color:#1B5E20'&gt;&lt;b&gt;Software:&lt;/b&gt; the relay is driven by the SAME pin (BCM 27 / T13). HIGH closes CH2 → solenoid opens. No code change needed for wiring, but the libgpiod gate-drive can be switched back to Jetson.GPIO on BCM 27 since the relay input is high-impedance (3.3V is plenty).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9C27B0;fontColor=#333;fontSize=11;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="700" width="1290" height="300" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
