                    <mxGeometry x="900" y="300" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="soll" value="&lt;b style='color:#FFB74D;font-size:14px'&gt;GOODRIG Solenoid&lt;/b&gt;&lt;br&gt;&lt;span style='color:#CFD8DC;font-size:10px'&gt;12V normally-closed valve&lt;br&gt;(+) RED → Relay CH2 NO&lt;br&gt;(−) BLUE → GND (moved off MOSFET)&lt;/span&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="905" y="312" width="210" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="flyback" value="&lt;b style='color:#880E4F;font-size:12px'&gt;1N4007 Flyback&lt;/b&gt;&lt;br&gt;&lt;span style='color:#AD1457;font-size:10px'&gt;across solenoid coil&lt;br&gt;band (cathode) → (+) side&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;shadow=1;arcSize=10;fontColor=#333;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="320" width="170" height="60" as="geometry"/>
                </mxCell>

                <mxCell id="remove" value="&lt;b style='font-size:13px;color:#B71C1C'&gt;✕ REMOVE (MOSFET path)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#C62828;font-size:11px'&gt;• IRLB8721 MOSFET (all 3 legs)&lt;br&gt;• 4.7kΩ pull-up + any added 1kΩ&lt;br&gt;• T17 (+3.3V) → resistor wire&lt;br&gt;• MOSFET Drain → solenoid (−) blue&lt;br&gt;• MOSFET Source → GND&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;dashed=1;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;fontColor=#333;" parent="1" vertex="1">
                    <mxGeometry x="380" y="460" width="370" height="150" as="geometry"/>
                </mxCell>

