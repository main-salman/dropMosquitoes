        <mxCell id="w_5v_yaw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#dc2626;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="buck_5v_out" target="yaw_vcc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="310" y="612"/><mxPoint x="310" y="830"/><mxPoint x="960" y="830"/><mxPoint x="960" y="595"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w_5v_yaw_l" value="&lt;font color=&quot;#dc2626&quot;&gt;&lt;b&gt;+5V Power (Red) — direct to servo&lt;/b&gt;&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;" vertex="1" connectable="0" parent="w_5v_yaw">
          <mxGeometry x="0.2" y="15" relative="1" as="geometry"/>
        </mxCell>

        <!-- Buck 5V → Pitch VCC -->
        <mxCell id="w_5v_pitch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#dc2626;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="buck_5v_out" target="pitch_vcc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="310" y="612"/><mxPoint x="310" y="850"/><mxPoint x="970" y="850"/><mxPoint x="970" y="765"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- Buck GND → Yaw GND -->
        <mxCell id="w_gnd_servos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="buck_gnd_out" target="yaw_gnd">
          <mxGeometry relative="1" as="geometry">
