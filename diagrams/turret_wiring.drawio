          <mxGeometry x="0.3" y="15" relative="1" as="geometry"/>
        </mxCell>

        <!-- GND daisy chain to pitch -->
        <mxCell id="w_gnd_pitch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="yaw_gnd" target="pitch_gnd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Screw terminal note -->
        <mxCell id="screw_unused" value="&lt;font color=&quot;#888888&quot; style=&quot;font-size:8px&quot;&gt;Screw terminal UNUSED&lt;br&gt;(power goes direct to servos)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="545" y="608" width="120" height="25" as="geometry"/>
        </mxCell>

        <!-- ====== GROUND TIE (Critical!) ====== -->
        <mxCell id="w_ground_tie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b45309;strokeWidth=3;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="buck_gnd_out" target="pin9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="280" y="642"/><mxPoint x="280" y="250"/><mxPoint x="660" y="250"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w_gt_label" value="&lt;font color=&quot;#b45309&quot;&gt;&lt;b&gt;⚡ GROUND TIE&lt;/b&gt;&lt;br&gt;Jumper wire — mandatory&lt;br&gt;for PWM signal return path&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;" vertex="1" connectable="0" parent="w_ground_tie">
          <mxGeometry x="-0.4" y="-30" relative="1" as="geometry"/>
        </mxCell>

        <!-- ====== WIRING: Wago → Buck (12V Input) ====== -->
        <mxCell id="w_wago_buck12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#cc0000;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="wago" target="buck_12v_in">
          <mxGeometry relative="1" as="geometry">
