        <mxCell id="w_wago_buckgnd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="wago_gnd" target="buck_gnd_in">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="310" y="490"/><mxPoint x="90" y="490"/><mxPoint x="90" y="642"/><mxPoint x="100" y="642"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- ====== Wago → Jetson barrel jack ====== -->
        <mxCell id="w_wago_jetson" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#cc0000;strokeWidth=2;endArrow=block;endFill=1;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="wago" target="jetson">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="380" y="340"/><mxPoint x="380" y="200"/><mxPoint x="460" y="200"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w_wago_jetson_l" value="&lt;font color=&quot;#cc0000&quot; style=&quot;font-size:9px&quot;&gt;12V via barrel jack&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="w_wago_jetson">
          <mxGeometry x="-0.2" relative="1" as="geometry"/>
        </mxCell>

        <!-- ====== SAFETY NOTE ====== -->
        <mxCell id="safety_note" value="&lt;b&gt;⚠️ SAFETY NOTES&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Servo power (5V/10A) is &lt;b&gt;fully isolated&lt;/b&gt;&lt;br&gt;   from Jetson 5V rail — no brownout risk&lt;br&gt;&lt;br&gt;2. Ground tie jumper is &lt;b&gt;mandatory&lt;/b&gt; for&lt;br&gt;   PWM signal to have a return path&lt;br&gt;&lt;br&gt;&lt;b&gt;🔗 SHARED PIN SAFETY&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. &lt;b&gt;I2C is a bus&lt;/b&gt; — Pin 3 (SDA) and Pin 5 (SCL)&lt;br&gt;   are shared with TF-Luna LiDAR. This is correct:&lt;br&gt;   LiDAR=0x10, PCA9685=0x40 (no address conflict)&lt;br&gt;&lt;br&gt;4. &lt;b&gt;GND pins are a common rail&lt;/b&gt; — Pin 6 and Pin 9&lt;br&gt;   are shared with LiDAR GND and Relay GND.&lt;br&gt;   All devices MUST share ground. Safe to tap.&lt;br&gt;&lt;br&gt;5. No new pins are consumed — PCA9685 only&lt;br&gt;   needs existing I2C bus + existing GND." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff3cd;strokeColor=#d6b656;fontColor=#333333;fontSize=10;align=left;spacingLeft=10;spacingRight=10;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1280" y="80" width="280" height="340" as="geometry"/>
        </mxCell>

        <!-- Wire legend -->
        <mxCell id="legend_box" value="&lt;b&gt;Wire Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;━━ Red: +12V / +3.3V power&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#dc2626&quot;&gt;━━ Red (thick): +5V servo power&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;━━ Black: GND&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;╍╍ Amber dashed: Ground tie&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2563eb&quot;&gt;━━ Blue: I2C SDA&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#16a34a&quot;&gt;━━ Green: I2C SCL&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ea580c&quot;&gt;━━ Orange: PWM signal&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#333333;fontSize=10;align=left;spacingLeft=10;spacingRight=10;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1280" y="360" width="260" height="170" as="geometry"/>
        </mxCell>

      </root>
