        <mxCell id="rxlbl" value="&lt;span style='color:#90CAF9;font-size:9px'&gt;&lt;b&gt;HDMI→CSI&lt;/b&gt;&lt;br&gt;RX Board&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="685" y="175" width="80" height="25" as="geometry"/></mxCell>
        <mxCell id="rxcap" value="&lt;b style='color:#333;font-size:10px'&gt;RX Board&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555;font-size:9px'&gt;Fixed near Jetson&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="665" y="225" width="120" height="25" as="geometry"/></mxCell>

