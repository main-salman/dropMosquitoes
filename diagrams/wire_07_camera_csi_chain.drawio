        <mxCell id="zbl" value="&lt;b style='color:#C62828;font-size:12px'&gt;ZONE B: The Umbilical&lt;/b&gt;&lt;br&gt;&lt;span style='color:#D32F2F;font-size:9px'&gt;Bridges movement axes — absorbs pan/tilt&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="395" y="76" width="200" height="28" as="geometry"/></mxCell>

