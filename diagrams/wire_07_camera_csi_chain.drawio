<mxfile>
  <diagram name="Camera CSI Chain" id="csi_v3">
    <mxGraphModel dx="1400" dy="900" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;WIRE 07: Sniper Camera CSI Extension Chain&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Zone A (Gimbal) → Zone B (Umbilical) → Zone C (Enclosure) — Physical topology for IMX219&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="800" height="45" as="geometry"/></mxCell>

        <mxCell id="za" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#FF6D00;strokeWidth=3;dashed=0;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="330" height="310" as="geometry"/></mxCell>
        <mxCell id="zal" value="&lt;b style='color:#E65100;font-size:12px'&gt;ZONE A: Moving Payload&lt;/b&gt;&lt;br&gt;&lt;span style='color:#FF6D00;font-size:9px'&gt;Mounted on gimbal — moves with pan/tilt&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="76" width="270" height="28" as="geometry"/></mxCell>

        <mxCell id="cam" value="" style="rounded=1;fillColor=#0D47A1;strokeColor=#42A5F5;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="120" height="100" as="geometry"/></mxCell>
