        <mxCell id="s1" value="&lt;b&gt;TX Board&lt;/b&gt;&lt;br&gt;15-pin FPC in&lt;br&gt;HDMI out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33334D;strokeColor=#9C27B0;fontColor=#FFF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="120" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;HDMI Cable&lt;/b&gt;&lt;br&gt;Through PG11&lt;br&gt;cable gland" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01579B;strokeColor=#0288D1;fontColor=#FFF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="120" height="70" as="geometry"/></mxCell>
