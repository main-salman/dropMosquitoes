        <mxCell id="zcl" value="&lt;b style='color:#2E7D32;font-size:12px'&gt;ZONE C: Static Base (IP67 Enclosure)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4CAF50;font-size:9px'&gt;Fixed inside enclosure — no movement&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="76" width="320" height="28" as="geometry"/></mxCell>

        <mxCell id="gland" value="" style="ellipse;fillColor=#455A64;strokeColor=#37474F;" vertex="1" parent="1"><mxGeometry x="635" y="160" width="16" height="16" as="geometry"/></mxCell>
