        <mxCell id="hdmil" value="&lt;b style='color:#C62828;font-size:11px'&gt;Ultra-Thin Flexible&lt;br&gt;FPV HDMI Cable&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="415" y="118" width="160" height="28" as="geometry"/></mxCell>
        <mxCell id="hdmisub" value="&lt;span style='color:#D32F2F;font-size:9px'&gt;Ribbon-like, zero resistance&lt;br&gt;Service loop for pan/tilt&lt;br&gt;⚠ Standard cables PROHIBITED&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="415" y="320" width="175" height="35" as="geometry"/></mxCell>

