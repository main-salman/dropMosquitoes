        <mxCell id="camir" value="" style="ellipse;fillColor=#CFB53B;strokeColor=#B8860B;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="92" y="142" width="12" height="12" as="geometry"/></mxCell>
        <mxCell id="campcb" value="" style="rounded=0;fillColor=#1B5E20;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="65" y="170" width="50" height="30" as="geometry"/></mxCell>
