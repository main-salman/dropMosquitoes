        <mxCell id="camlbl" value="&lt;b style='color:#333;font-size:10px'&gt;IMX219 NoIR&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555;font-size:9px'&gt;Arducam 8MP&lt;br&gt;Sniper Camera&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="55" y="230" width="130" height="35" as="geometry"/></mxCell>

