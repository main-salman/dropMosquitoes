        <mxCell id="fpc1l" value="&lt;span style='font-size:8px;color:#E65100'&gt;2&amp;quot; FPC&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="175" y="154" width="40" height="12" as="geometry"/></mxCell>

