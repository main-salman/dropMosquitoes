        <mxCell id="rx" value="" style="rounded=1;fillColor=#1565C0;strokeColor=#1976D2;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="665" y="120" width="120" height="100" as="geometry"/></mxCell>
