        <mxCell id="txlbl" value="&lt;span style='color:#90CAF9;font-size:9px'&gt;&lt;b&gt;CSI→HDMI&lt;/b&gt;&lt;br&gt;TX Board&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="225" y="175" width="80" height="25" as="geometry"/></mxCell>
        <mxCell id="txcap" value="&lt;b style='color:#333;font-size:10px'&gt;TX Board&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555;font-size:9px'&gt;Bolted to payload plate&lt;br&gt;Moves with camera&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="210" y="235" width="120" height="35" as="geometry"/></mxCell>

