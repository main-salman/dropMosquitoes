        <mxCell id="wire_gimbal_gnd" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=3;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="gimbal" target="wago_gnd">
