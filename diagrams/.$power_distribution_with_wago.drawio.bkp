        <mxCell id="wire_idc_gnd" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="idc" target="relay">
