<mxfile>
  <diagram name="BEFORE — Current Wiring" id="before">
    <mxGraphModel dx="1400" dy="1200" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="600" background="#FFF8E1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Title -->
        <mxCell id="t1" value="&lt;b style='font-size:18px;color:#E65100'&gt;BEFORE — Current Wiring (What You Have Now)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#BF360C;font-size:11px'&gt;Both BCM 17 and BCM 27 go to the Monk Makes Dual Relay board&lt;/span&gt;" style="text;html=1;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="700" height="45" as="geometry"/></mxCell>
        <!-- ===== JETSON IDC40P ===== -->
        <mxCell id="jetson" value="" style="rounded=1;fillColor=#1B5E20;strokeColor=#2E7D32;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="250" as="geometry"/></mxCell>
        <mxCell id="jlbl" value="&lt;b style='color:#C8E6C9;font-size:14px'&gt;Jetson Orin Nano&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A5D6A7;font-size:10px'&gt;IDC40P Terminal Block&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="180" height="30" as="geometry"/></mxCell>
        <!-- Terminal 11 / BCM 17 -->
        <mxCell id="t11" value="" style="rounded=1;fillColor=#2E7D32;strokeColor=#388E3C;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="t11l" value="&lt;b style='color:#C8E6C9;font-size:11px'&gt;Terminal 11 / BCM 17&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A5D6A7;font-size:9px'&gt;Orange wire → Relay IN1&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="163" width="170" height="30" as="geometry"/></mxCell>
        <!-- Terminal 13 / BCM 27 -->
        <mxCell id="t13" value="" style="rounded=1;fillColor=#2E7D32;strokeColor=#388E3C;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="t13l" value="&lt;b style='color:#C8E6C9;font-size:11px'&gt;Terminal 13 / BCM 27&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A5D6A7;font-size:9px'&gt;Yellow wire → Relay IN2&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="223" width="170" height="30" as="geometry"/></mxCell>
        <!-- GND -->
        <mxCell id="gnd1" value="" style="rounded=1;fillColor=#333;strokeColor=#555;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="180" height="35" as="geometry"/></mxCell>
        <mxCell id="gnd1l" value="&lt;b style='color:#CCC;font-size:10px'&gt;Terminal 6/9/14 (GND)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="285" width="170" height="18" as="geometry"/></mxCell>

        <!-- ===== WIRES TO RELAY ===== -->
        <!-- BCM 17 → Relay IN1 (stays) -->
        <mxCell id="w1" value="" style="endArrow=block;endFill=1;strokeColor=#FF9800;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="180" as="sourcePoint"/><mxPoint x="420" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w1l" value="&lt;b style='font-size:9px;color:#E65100'&gt;ORANGE wire&lt;br&gt;(STAYS — no change)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="152" width="120" height="25" as="geometry"/></mxCell>
        <!-- BCM 27 → Relay IN2 (WILL MOVE) -->
        <mxCell id="w2" value="" style="endArrow=block;endFill=1;strokeColor=#FFEB3B;strokeWidth=4;rounded=1;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="240" as="sourcePoint"/><mxPoint x="420" y="240" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w2l" value="&lt;b style='font-size:9px;color:#F57F17'&gt;YELLOW wire&lt;br&gt;⚠ THIS WIRE MOVES!&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="212" width="120" height="25" as="geometry"/></mxCell>
        <!-- GND → Relay -->
        <mxCell id="wg" value="" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="297" as="sourcePoint"/><mxPoint x="420" y="297" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wgl" value="&lt;span style='font-size:8px;color:#666'&gt;GND&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="40" height="12" as="geometry"/></mxCell>

        <!-- ===== MONK MAKES DUAL RELAY ===== -->
        <mxCell id="relay" value="" style="rounded=1;fillColor=#3E2723;strokeColor=#5D4037;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="250" height="250" as="geometry"/></mxCell>
        <mxCell id="rlbl" value="&lt;b style='color:#BCAAA4;font-size:14px'&gt;Monk Makes Dual Relay&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="230" height="20" as="geometry"/></mxCell>
        <!-- CH1 -->
        <mxCell id="ch1" value="" style="rounded=1;fillColor=#4E342E;strokeColor=#6D4C41;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="145" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="ch1l" value="&lt;b style='color:#BCAAA4;font-size:11px'&gt;CH1 (IN1 ← BCM 17)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A1887F;font-size:9px'&gt;NO/COM switches +12V to pump&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="445" y="150" width="200" height="35" as="geometry"/></mxCell>
        <!-- CH2 -->
        <mxCell id="ch2" value="" style="rounded=1;fillColor=#4E342E;strokeColor=#FFEB3B;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="440" y="215" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="ch2l" value="&lt;b style='color:#FFEB3B;font-size:11px'&gt;CH2 (IN2 ← BCM 27)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#FFD54F;font-size:9px'&gt;⚠ Currently: Gimbal power (UNUSED)&lt;br&gt;Will be DISCONNECTED&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="445" y="218" width="200" height="42" as="geometry"/></mxCell>

        <!-- ===== RELAY → PUMP ===== -->
        <mxCell id="w3" value="" style="endArrow=block;endFill=1;strokeColor=#F44336;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="172" as="sourcePoint"/><mxPoint x="810" y="172" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w3l" value="&lt;b style='font-size:9px;color:#C62828'&gt;RED wire (+12V switched)&lt;br&gt;(STAYS — no change)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="690" y="145" width="130" height="25" as="geometry"/></mxCell>
        <!-- PUMP -->
        <mxCell id="pump" value="" style="rounded=1;fillColor=#0D47A1;strokeColor=#1565C0;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="130" width="180" height="85" as="geometry"/></mxCell>
        <mxCell id="plbl" value="&lt;b style='color:#BBDEFB;font-size:12px'&gt;R385 Pump&lt;/b&gt;&lt;br&gt;&lt;span style='color:#90CAF9;font-size:9px'&gt;12V motor on Relay CH1&lt;br&gt;No changes needed&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="140" width="160" height="42" as="geometry"/></mxCell>

        <!-- CH2 → Gimbal (dead connection) -->
        <mxCell id="w4" value="" style="endArrow=block;endFill=1;strokeColor=#9E9E9E;strokeWidth=3;rounded=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="242" as="sourcePoint"/><mxPoint x="810" y="242" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w4l" value="&lt;span style='font-size:9px;color:#9E9E9E'&gt;DEAD (gimbal bypassed)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="690" y="248" width="120" height="14" as="geometry"/></mxCell>
        <!-- Dead gimbal label -->
        <mxCell id="gimb" value="" style="rounded=1;fillColor=#EEEEEE;strokeColor=#BDBDBD;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="810" y="225" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="gimblbl" value="&lt;span style='color:#9E9E9E;font-size:11px'&gt;&lt;s&gt;Storm32 Gimbal&lt;/s&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Replaced by MG996R servos&lt;/span&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="230" width="160" height="35" as="geometry"/></mxCell>

        <!-- MOSFET not connected yet -->
        <mxCell id="mosfet_na" value="" style="rounded=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="810" y="310" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="mosfet_na_lbl" value="&lt;span style='color:#BDBDBD;font-size:11px'&gt;&lt;b&gt;IRLB8721 MOSFET&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Not connected yet&lt;/span&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="318" width="160" height="35" as="geometry"/></mxCell>

        <!-- Note -->
        <mxCell id="note1" value="&lt;b style='color:#E65100;font-size:11px'&gt;STATUS:&lt;/b&gt; BCM 27 is wired to Relay CH2 (currently doing nothing — gimbal replaced by servos). MOSFET + Solenoid hardware ordered but not wired." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;fontColor=#333;fontSize=10;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="700" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="AFTER — New Wiring" id="after">
    <mxGraphModel dx="1400" dy="1200" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" background="#E8F5E9">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Title -->
        <mxCell id="t2" value="&lt;b style='font-size:18px;color:#2E7D32'&gt;AFTER — New Wiring (What To Change)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#388E3C;font-size:11px'&gt;BCM 17 stays on Relay CH1 (pump). BCM 27 moves to MOSFET gate (solenoid).&lt;/span&gt;" style="text;html=1;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="700" height="45" as="geometry"/></mxCell>
        <!-- ===== JETSON IDC40P ===== -->
        <mxCell id="jetson2" value="" style="rounded=1;fillColor=#1B5E20;strokeColor=#2E7D32;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="300" as="geometry"/></mxCell>
        <mxCell id="j2lbl" value="&lt;b style='color:#C8E6C9;font-size:14px'&gt;Jetson Orin Nano&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A5D6A7;font-size:10px'&gt;IDC40P Terminal Block&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="180" height="30" as="geometry"/></mxCell>
        <!-- Terminal 11 / BCM 17 — NO CHANGE -->
        <mxCell id="t11b" value="" style="rounded=1;fillColor=#2E7D32;strokeColor=#388E3C;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="t11bl" value="&lt;b style='color:#C8E6C9;font-size:11px'&gt;Terminal 11 / BCM 17&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A5D6A7;font-size:9px'&gt;Orange wire → Relay IN1 (NO CHANGE)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="163" width="170" height="30" as="geometry"/></mxCell>
        <!-- Terminal 13 / BCM 27 — CHANGED -->
        <mxCell id="t13b" value="" style="rounded=1;fillColor=#4CAF50;strokeColor=#FFEB3B;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="225" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="t13bl" value="&lt;b style='color:#FFF;font-size:11px'&gt;Terminal 13 / BCM 27&lt;/b&gt;&lt;br&gt;&lt;span style='color:#C8E6C9;font-size:9px'&gt;⚡ Green wire → MOSFET Gate (NEW!)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="228" width="170" height="30" as="geometry"/></mxCell>
        <!-- GND -->
        <mxCell id="gnd2" value="" style="rounded=1;fillColor=#333;strokeColor=#555;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="180" height="35" as="geometry"/></mxCell>
        <mxCell id="gnd2l" value="&lt;b style='color:#CCC;font-size:10px'&gt;Terminal 6/9/14 (GND)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="295" width="170" height="18" as="geometry"/></mxCell>
        <!-- 5V -->
        <mxCell id="v5" value="" style="rounded=1;fillColor=#F44336;strokeColor=#C62828;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="180" height="35" as="geometry"/></mxCell>
        <mxCell id="v5l" value="&lt;b style='color:#FFF;font-size:10px'&gt;+12V DC Bus (Wago/PSU)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="350" width="170" height="18" as="geometry"/></mxCell>

        <!-- ===== PATH 1: BCM 17 → RELAY CH1 → PUMP (unchanged) ===== -->
        <mxCell id="w1b" value="" style="endArrow=block;endFill=1;strokeColor=#FF9800;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="180" as="sourcePoint"/><mxPoint x="420" y="150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w1bl" value="&lt;b style='font-size:9px;color:#E65100'&gt;ORANGE wire&lt;br&gt;✅ NO CHANGE&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="128" width="100" height="25" as="geometry"/></mxCell>
        <!-- Relay (only CH1 now) -->
        <mxCell id="relay2" value="" style="rounded=1;fillColor=#3E2723;strokeColor=#5D4037;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="r2lbl" value="&lt;b style='color:#BCAAA4;font-size:13px'&gt;Monk Makes Relay&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A1887F;font-size:10px'&gt;Only CH1 used now&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="108" width="180" height="28" as="geometry"/></mxCell>
        <mxCell id="ch1b" value="" style="rounded=1;fillColor=#4E342E;strokeColor=#6D4C41;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="145" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="ch1bl" value="&lt;b style='color:#BCAAA4;font-size:11px'&gt;CH1 (BCM 17)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A1887F;font-size:9px'&gt;Switches +12V → Pump&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="445" y="148" width="150" height="35" as="geometry"/></mxCell>
        <!-- Relay → Pump -->
        <mxCell id="w3b" value="" style="endArrow=block;endFill=1;strokeColor=#F44336;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="170" as="sourcePoint"/><mxPoint x="810" y="170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w3bl" value="&lt;b style='font-size:9px;color:#C62828'&gt;RED wire (+12V switched)&lt;br&gt;✅ NO CHANGE&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="130" height="25" as="geometry"/></mxCell>
        <!-- PUMP -->
        <mxCell id="pump2" value="" style="rounded=1;fillColor=#0D47A1;strokeColor=#1565C0;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="130" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="p2lbl" value="&lt;b style='color:#BBDEFB;font-size:13px'&gt;R385 Pump Motor&lt;/b&gt;&lt;br&gt;&lt;span style='color:#90CAF9;font-size:10px'&gt;+12V via Relay CH1 (no change)&lt;br&gt;Charge-on-demand only&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="138" width="180" height="45" as="geometry"/></mxCell>

        <!-- ===== PATH 2: BCM 27 → MOSFET → SOLENOID (NEW!) ===== -->
        <!-- BCM 27 wire to MOSFET -->
        <mxCell id="w2b" value="" style="endArrow=block;endFill=1;strokeColor=#4CAF50;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="245" as="sourcePoint"/><mxPoint x="420" y="340" as="targetPoint"/><Array as="points"><mxPoint x="330" y="245"/><mxPoint x="330" y="340"/></Array></mxGeometry></mxCell>
        <mxCell id="w2bl" value="&lt;b style='font-size:10px;color:#2E7D32'&gt;🔀 GREEN wire (NEW!)&lt;br&gt;Remove from Relay IN2&lt;br&gt;Connect to MOSFET Gate&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="265" y="268" width="145" height="45" as="geometry"/></mxCell>

        <!-- 10kΩ pull-down -->
        <mxCell id="pd2" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#FFB74D;shadow=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="pd2l" value="&lt;b style='color:#E65100;font-size:11px'&gt;10kΩ Resistor&lt;/b&gt;&lt;br&gt;&lt;span style='color:#BF360C;font-size:9px'&gt;Gate ↔ GND (boot safety)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="425" y="285" width="120" height="35" as="geometry"/></mxCell>

        <!-- MOSFET -->
        <mxCell id="mos2" value="" style="rounded=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="mos2pkg" value="" style="rounded=0;fillColor=#3F51B5;strokeColor=#283593;" vertex="1" parent="1"><mxGeometry x="435" y="360" width="35" height="65" as="geometry"/></mxCell>
        <mxCell id="mos2l" value="&lt;b style='color:#283593;font-size:13px'&gt;IRLB8721PBF&lt;/b&gt;&lt;br&gt;&lt;span style='color:#3F51B5;font-size:9px'&gt;N-Ch MOSFET (TO-220)&lt;br&gt;&lt;b&gt;G&lt;/b&gt; ← BCM 27 (green wire)&lt;br&gt;&lt;b&gt;D&lt;/b&gt; → Solenoid (−) terminal&lt;br&gt;&lt;b&gt;S&lt;/b&gt; → GND bus&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="475" y="345" width="140" height="65" as="geometry"/></mxCell>
        <!-- MOSFET pin labels -->
        <mxCell id="mpG" value="&lt;b style='color:#4CAF50;font-size:9px'&gt;G&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="425" y="345" width="15" height="15" as="geometry"/></mxCell>
        <mxCell id="mpD" value="&lt;b style='color:#F44336;font-size:9px'&gt;D&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="425" y="383" width="15" height="15" as="geometry"/></mxCell>
        <mxCell id="mpS" value="&lt;b style='color:#333;font-size:9px'&gt;S&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="425" y="410" width="15" height="15" as="geometry"/></mxCell>

        <!-- MOSFET Drain → Solenoid -->
        <mxCell id="w4b" value="" style="endArrow=block;endFill=1;strokeColor=#5C6BC0;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="395" as="sourcePoint"/><mxPoint x="810" y="395" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w4bl" value="&lt;span style='font-size:9px;color:#283593'&gt;&lt;b&gt;BLUE wire&lt;/b&gt;&lt;br&gt;Drain → Sol(−)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="655" y="370" width="90" height="22" as="geometry"/></mxCell>

        <!-- SOLENOID VALVE -->
        <mxCell id="sol2" value="" style="rounded=1;fillColor=#263238;strokeColor=#37474F;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="810" y="300" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="sol2coil" value="" style="rounded=1;fillColor=#37474F;strokeColor=#455A64;arcSize=8;" vertex="1" parent="1"><mxGeometry x="850" y="325" width="120" height="25" as="geometry"/></mxCell>
        <mxCell id="sol2l" value="&lt;b style='color:#B0BEC5;font-size:13px'&gt;GOODRIG Solenoid&lt;/b&gt;&lt;br&gt;&lt;span style='color:#78909C;font-size:9px'&gt;12V DC Normally-Closed&lt;br&gt;(+) → +12V bus (red wire)&lt;br&gt;(−) → MOSFET Drain (blue wire)&lt;br&gt;&lt;b style='color:#4CAF50'&gt;ON SERVO TURRET&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="825" y="352" width="170" height="65" as="geometry"/></mxCell>
        <!-- +12V → Solenoid (+) -->
        <mxCell id="w5b" value="" style="endArrow=block;endFill=1;strokeColor=#F44336;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="300" as="sourcePoint"/><mxPoint x="910" y="272" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v12bus2" value="&lt;b style='color:#FFF;font-size:10px'&gt;+12V Bus&lt;/b&gt;" style="rounded=1;fillColor=#F44336;strokeColor=#C62828;arcSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="248" width="100" height="25" as="geometry"/></mxCell>

        <!-- 1N4007 flyback diode -->
        <mxCell id="diode2" value="" style="rounded=1;fillColor=#FCE4EC;strokeColor=#E91E63;shadow=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="diode2l" value="&lt;b style='color:#880E4F;font-size:11px'&gt;1N4007 Flyback ⚡&lt;/b&gt;&lt;br&gt;&lt;span style='color:#AD1457;font-size:9px'&gt;Across solenoid terminals&lt;br&gt;Anode→(−) Cathode→(+)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="1045" y="345" width="130" height="42" as="geometry"/></mxCell>
        <!-- Diode wires -->
        <mxCell id="dw1" value="" style="endArrow=none;strokeColor=#E91E63;strokeWidth=2;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="355" as="sourcePoint"/><mxPoint x="1040" y="355" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="dw2" value="" style="endArrow=none;strokeColor=#E91E63;strokeWidth=2;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="385" as="sourcePoint"/><mxPoint x="1040" y="385" as="targetPoint"/></mxGeometry></mxCell>

        <!-- GND bus -->
        <mxCell id="gndbus" value="" style="rounded=1;fillColor=#333;strokeColor=#555;shadow=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1150" height="28" as="geometry"/></mxCell>
        <mxCell id="gndbusl" value="&lt;b style='color:#CCC;font-size:11px'&gt;GND Bus — Common Ground (Jetson GND + 12V PSU GND + MOSFET Source)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="494" width="700" height="18" as="geometry"/></mxCell>
        <!-- GND connections -->
        <mxCell id="gw1b" value="" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="340" as="sourcePoint"/><mxPoint x="140" y="490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="gw2b" value="" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="460" as="sourcePoint"/><mxPoint x="450" y="490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="gw2bl" value="&lt;span style='font-size:8px;color:#666'&gt;MOSFET Source&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="468" width="70" height="12" as="geometry"/></mxCell>

        <!-- ===== INSTRUCTIONS BOX ===== -->
        <mxCell id="instbox" value="&lt;b style='font-size:13px;color:#1B5E20'&gt;📋 WIRING CHANGES — Step by Step:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#C62828'&gt;1. DISCONNECT:&lt;/b&gt; Remove the YELLOW wire from &lt;b&gt;Relay IN2&lt;/b&gt; (Relay CH2 is now unused)&lt;br&gt;&lt;br&gt;&lt;b style='color:#2E7D32'&gt;2. RECONNECT:&lt;/b&gt; Run a GREEN wire from &lt;b&gt;Terminal 13 (BCM 27)&lt;/b&gt; to the &lt;b&gt;GATE pin&lt;/b&gt; of the IRLB8721 MOSFET (left pin, TO-220 facing you, tab at back)&lt;br&gt;&lt;br&gt;&lt;b style='color:#E65100'&gt;3. ADD PULL-DOWN:&lt;/b&gt; Solder a &lt;b&gt;10kΩ resistor&lt;/b&gt; between MOSFET Gate and GND (prevents solenoid firing during Jetson boot)&lt;br&gt;&lt;br&gt;&lt;b style='color:#1565C0'&gt;4. CONNECT MOSFET DRAIN:&lt;/b&gt; Run a BLUE wire from MOSFET &lt;b&gt;Drain pin&lt;/b&gt; (center pin) to Solenoid &lt;b&gt;(−) terminal&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#1565C0'&gt;5. CONNECT MOSFET SOURCE:&lt;/b&gt; Run a BLACK wire from MOSFET &lt;b&gt;Source pin&lt;/b&gt; (right pin) to &lt;b&gt;GND bus&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#C62828'&gt;6. CONNECT SOLENOID POWER:&lt;/b&gt; Run a RED wire from &lt;b&gt;+12V bus&lt;/b&gt; (Wago) to Solenoid &lt;b&gt;(+) terminal&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#880E4F'&gt;7. ADD FLYBACK DIODE:&lt;/b&gt; Solder &lt;b&gt;1N4007&lt;/b&gt; across solenoid terminals: &lt;b&gt;Anode→(−)&lt;/b&gt;, &lt;b&gt;Cathode(stripe)→(+)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='color:#388E3C;font-size:10px'&gt;✅ Pump wiring (BCM 17 → Relay CH1 → R385) is UNCHANGED. Don't touch it.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#4CAF50;fontColor=#333;fontSize=10;strokeWidth=2;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1150" height="230" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
