                <mxCell id="g85OO_5E283azgmpjkhN-84" value="&lt;b style='color:#B0BEC5;font-size:13px'&gt;GOODRIG Solenoid&lt;/b&gt;&lt;br&gt;&lt;span style='color:#78909C;font-size:9px'&gt;12V DC Normally-Closed&lt;br&gt;(+) → +12V bus (red wire)&lt;br&gt;(−) → MOSFET Drain (blue wire)&lt;br&gt;&lt;b style='color:#4CAF50'&gt;ON SERVO TURRET&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
