                </mxCell>
                <mxCell id="g85OO_5E283azgmpjkhN-92" value="&lt;b style='color:#CCC;font-size:11px'&gt;GND Bus — Common Ground (Jetson GND + 12V PSU GND + MOSFET Source)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
