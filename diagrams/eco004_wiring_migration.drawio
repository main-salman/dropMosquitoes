                <mxCell id="g85OO_5E283azgmpjkhN-81" value="&lt;span style='font-size:9px;color:#283593'&gt;&lt;b&gt;BLUE wire&lt;/b&gt;&lt;br&gt;Middle pin (D) → Sol(−)&lt;br&gt;Tab is also D — don't use both&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
