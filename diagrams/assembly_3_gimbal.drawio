        <!-- Labels -->
        <mxCell id="note" value="&lt;b&gt;Payload rides on gimbal:&lt;/b&gt; Sniper cam, LiDAR, and nozzle all move together — boresighted for precision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#2196F3;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="440" width="500" height="30" as="geometry"/></mxCell>
