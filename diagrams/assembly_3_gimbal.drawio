<mxfile>
  <diagram name="Gimbal Assembly" id="asm3_v2">
    <mxGraphModel dx="1200" dy="800" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" background="#FFFFFF">
      <root>
