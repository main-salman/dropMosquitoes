        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;ASSEMBLY 3: Gimbal Detail&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Storm32 2-axis gimbal — motors, controller, payload plate&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="500" height="45" as="geometry"/></mxCell>
