        <mxCell id="yawl" value="&lt;b style='color:#B0BEC5;font-size:11px'&gt;YAW Motor&lt;/b&gt;&lt;br&gt;&lt;span style='color:#78909C;font-size:9px'&gt;±130° range&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="105" width="100" height="25" as="geometry"/></mxCell>
