                <mxCell id="outl" value="&lt;b style='color:#FFE0B2;font-size:12px'&gt;OUTPUT (screw terminals)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#BBDEFB;font-size:10px'&gt;OUT+ → solenoid (+)&lt;br&gt;OUT− → solenoid (−)&lt;br&gt;(module switches the low side)&lt;/span&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="496" y="380" width="276" height="64" as="geometry"/>
