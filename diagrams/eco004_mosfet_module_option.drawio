        <mxCell id="diode_box" value="&lt;b style='color:#880E4F'&gt;C8 · 1N5408&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#AD1457'&gt;BAND → RED (+) · no-band → BLUE (−)&lt;br&gt;sits across the two solenoid terminals&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;strokeWidth=3;align=center;" parent="1" vertex="1">
          <mxGeometry x="1120" y="640" width="240" height="70" as="geometry"/>
