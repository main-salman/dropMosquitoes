        <!-- C8 diode across -->
        <mxCell id="a_c8" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#E91E63;strokeWidth=4;rounded=1;dashed=1;" parent="1" edge="1">
