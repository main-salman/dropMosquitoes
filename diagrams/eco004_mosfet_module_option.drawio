        <mxCell id="picol" value="&lt;b style='color:#0D47A1;font-size:13px'&gt;PICO W&lt;/b&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="390" y="448" width="200" height="20" as="geometry"/>
