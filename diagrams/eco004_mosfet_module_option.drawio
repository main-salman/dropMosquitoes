          </mxGeometry>
        </mxCell>
        <mxCell id="a_c8l" value="&lt;b style='color:#C2185B;font-size:11px'&gt;C8 across coil&lt;/b&gt;" style="text;html=1;" parent="1" vertex="1">
          <mxGeometry x="1250" y="580" width="110" height="16" as="geometry"/>
        </mxCell>

        <!-- OHM + KEEP -->
        <mxCell id="ohm" value="&lt;b style='font-size:13px;color:#BF360C'&gt;Before wiring: check FET (loose)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#333'&gt;1) Short Gate↔Source 2s.&lt;br&gt;2) G↔S and G↔D = &lt;b&gt;OL&lt;/b&gt; both ways.&lt;br&gt;3) D↔S = &lt;b&gt;OL&lt;/b&gt; (Ω mode).&lt;br&gt;4) Diode: red on S, black on D ≈ 0.3–0.7V; reverse OL.&lt;br&gt;Fail any → scrap, use fresh FET.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;align=left;spacingLeft=10;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="40" y="800" width="400" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="keep" value="&lt;b style='font-size:13px;color:#1B5E20'&gt;Do NOT move (pump)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#333'&gt;• Cable &lt;b&gt;T11 → Relay IN A&lt;/b&gt; stays&lt;br&gt;• Pump +12V / GND / flyback stays&lt;br&gt;• Relay header GND stays&lt;br&gt;• No 2N3904 on this build&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;spacingLeft=10;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="460" y="800" width="300" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="sw" value="&lt;b style='font-size:13px;color:#E65100'&gt;Software note&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#333'&gt;Code still uses T36 SIG + T29 CH2.&lt;br&gt;These cables will &lt;b&gt;not&lt;/b&gt; click the valve until Pico FIRE firmware is added. Build the cables now; Click Test later.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF8F00;strokeWidth=2;align=left;spacingLeft=10;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="800" width="360" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="order" value="&lt;b style='font-size:14px;color:#0D47A1'&gt;Order to do it&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#222'&gt;&lt;b&gt;1.&lt;/b&gt; Unplug 12V · do &lt;b&gt;R1–R4&lt;/b&gt; · Ω-check FET&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Plug &lt;b&gt;C1&lt;/b&gt; (USB Jetson↔Pico)&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Connect &lt;b&gt;C2&lt;/b&gt; Pico GND→T6/T9/T14&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Connect &lt;b&gt;C3&lt;/b&gt; GP15→220Ω→Gate&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Connect &lt;b&gt;C4&lt;/b&gt; 10kΩ Gate→GND&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Connect &lt;b&gt;C5&lt;/b&gt; Source→GND&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Connect &lt;b&gt;C6&lt;/b&gt; BLUE→Drain&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Connect &lt;b&gt;C7&lt;/b&gt; +12V→fuse→RED&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; Install &lt;b&gt;C8&lt;/b&gt; diode across RED/BLUE (band on RED)&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; Run &lt;b&gt;AFTER-WIRE Ω table&lt;/b&gt; below (12V still OFF)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="1160" y="800" width="400" height="240" as="geometry"/>
        </mxCell>

        <!-- AFTER-WIRE RESISTANCE TABLE -->
        <mxCell id="ohm_after" value="&lt;b style='font-size:15px;color:#BF360C'&gt;★ AFTER WIRED — expected resistance (12V UNPLUGGED · Jetson OFF or USB only)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#B71C1C'&gt;Do NOT measure with +12V connected. Pico may stay on USB. Probes on the named pads/wires.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table cellpadding='5' style='font-size:12px;color:#111;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#FFE0B2'&gt;&lt;td&gt;&lt;b&gt;Probe A&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Probe B&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Expect (Ω / diode)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;If wrong&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Pico GP15&lt;/td&gt;&lt;td&gt;IRLB8721 Gate&lt;/td&gt;&lt;td&gt;&lt;b&gt;~220 Ω&lt;/b&gt; (±10%)&lt;/td&gt;&lt;td&gt;Wrong resistor / open C3&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FAFAFA'&gt;&lt;td&gt;IRLB8721 Gate&lt;/td&gt;&lt;td&gt;GND (T14 / Source)&lt;/td&gt;&lt;td&gt;&lt;b&gt;~10 kΩ&lt;/b&gt; (±10%)&lt;/td&gt;&lt;td&gt;Missing C4 pull-down / shorted Gate&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Pico GP15&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;&lt;b&gt;~10.2 kΩ&lt;/b&gt; (220 + 10k in series to GND)&lt;/td&gt;&lt;td&gt;Gate net wiring error&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FAFAFA'&gt;&lt;td&gt;IRLB8721 Source&lt;/td&gt;&lt;td&gt;GND bus (T6/T9/T14)&lt;/td&gt;&lt;td&gt;&lt;b&gt;~0 Ω&lt;/b&gt; (continuity beep)&lt;/td&gt;&lt;td&gt;C5 not landed / bad Wago&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Pico GND pin&lt;/td&gt;&lt;td&gt;GND bus / Source&lt;/td&gt;&lt;td&gt;&lt;b&gt;~0 Ω&lt;/b&gt;&lt;/td&gt;&lt;td&gt;C2 missing — fix before 12V&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FAFAFA'&gt;&lt;td&gt;Solenoid BLUE (−)&lt;/td&gt;&lt;td&gt;IRLB8721 Drain&lt;/td&gt;&lt;td&gt;&lt;b&gt;~0 Ω&lt;/b&gt;&lt;/td&gt;&lt;td&gt;C6 open&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Solenoid RED (+)&lt;/td&gt;&lt;td&gt;+12V side of fuse (load side)&lt;/td&gt;&lt;td&gt;&lt;b&gt;~0 Ω&lt;/b&gt;&lt;/td&gt;&lt;td&gt;C7 open / fuse out&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FAFAFA'&gt;&lt;td&gt;Fuse input (+12V bus)&lt;/td&gt;&lt;td&gt;Fuse output (→ RED)&lt;/td&gt;&lt;td&gt;&lt;b&gt;~0 Ω&lt;/b&gt; (good fuse)&lt;/td&gt;&lt;td&gt;Blown fuse = OL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Solenoid RED (+)&lt;/td&gt;&lt;td&gt;Solenoid BLUE (−)&lt;/td&gt;&lt;td&gt;&lt;b&gt;Coil ~ few Ω to tens of Ω&lt;/b&gt; (GOODRIG ~6–15 Ω typical) + diode in parallel — one polarity lower in diode mode&lt;/td&gt;&lt;td&gt;OL = open coil/wire; ~0 Ω = shorted coil or dead FET on&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FCE4EC'&gt;&lt;td&gt;1N5408 band (cathode / RED)&lt;/td&gt;&lt;td&gt;1N5408 no-band (anode / BLUE)&lt;/td&gt;&lt;td&gt;&lt;b&gt;Diode mode:&lt;/b&gt; black on band, red on no-band → ~0.5–0.8 V; reverse → OL&lt;/td&gt;&lt;td&gt;Band on wrong side / open diode&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;IRLB8721 Drain&lt;/td&gt;&lt;td&gt;IRLB8721 Source (G shorted sense: gate ~0 via 10k)&lt;/td&gt;&lt;td&gt;&lt;b&gt;Ω mode: OL or very high&lt;/b&gt; (channel OFF). Diode: red on S, black on D → ~0.3–0.7 V&lt;/td&gt;&lt;td&gt;Few Ω both ways = shorted FET — replace&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FAFAFA'&gt;&lt;td&gt;IRLB8721 Gate&lt;/td&gt;&lt;td&gt;IRLB8721 Drain&lt;/td&gt;&lt;td&gt;&lt;b&gt;OL / high&lt;/b&gt; (not a low-Ω path)&lt;/td&gt;&lt;td&gt;Low Ω = damaged FET or solder bridge&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+12V bus (fuse input)&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;&lt;b&gt;OL&lt;/b&gt; with 12V unplugged (no hard short). Coil path is through fuse→RED→coil→BLUE→Drain — not a DC short to GND when FET off&lt;/td&gt;&lt;td&gt;~0 Ω = short — stop, find fault before power&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#555'&gt;Tolerance: resistor values ±5–10% OK. Pico GPIO may add slight parallel paths when powered — if GP15↔GND reads much lower than ~10k with Pico on, unplug USB and recheck Gate↔GND = 10k alone.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;strokeWidth=3;align=left;spacingLeft=14;spacingRight=14;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="1060" width="1520" height="420" as="geometry"/>
        </mxCell>

        <mxCell id="footer" value="&lt;span style='font-size:10px;color:#666'&gt;HW-001 §5.4 Rev O · diagrams/eco004_mosfet_module_option.drawio · C1–C8 cable map + after-wire Ω table · 12V OFF for all Ω checks&lt;/span&gt;" style="text;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="1500" width="900" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
