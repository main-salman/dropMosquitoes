                <mxCell id="soll" value="&lt;b style='color:#FFB74D;font-size:14px'&gt;GOODRIG Solenoid&lt;/b&gt;&lt;br&gt;&lt;span style='color:#CFD8DC;font-size:10px'&gt;12V DC · 2A · 1/4&quot; NPT&lt;br&gt;direct-acting, normally closed&lt;br&gt;(+) RED → OUT+&lt;br&gt;(−) BLUE → OUT−&lt;/span&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="985" y="312" width="230" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="flyback" value="&lt;b style='color:#880E4F;font-size:12px'&gt;1N5408 Flyback (3A)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#AD1457;font-size:10px'&gt;across solenoid coil · &lt;b&gt;band (cathode) → (+) / OUT+ side&lt;/b&gt; · not the little 1N4007 (2A coil)&lt;br&gt;&lt;b style='color:#B71C1C'&gt;⚠ ONLY polarized part in this circuit — resistors cannot be &quot;backwards&quot;, this diode can.&lt;br&gt;Reversed (band → −) = dead short every time the valve fires → burns the module.&lt;/b&gt;&lt;br&gt;Verify VISUALLY: silver band faces the RED (+) wire. (Meter diode-mode can't test it in-circuit — the ~6Ω coil masks it. To meter-test, lift one diode leg: ~0.5-0.6V one way, OL the other.)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;shadow=1;arcSize=10;fontColor=#333;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
