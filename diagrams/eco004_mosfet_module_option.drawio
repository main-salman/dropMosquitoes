        <mxCell id="s_p" value="&lt;b style='color:#FFF'&gt;(+) RED&lt;/b&gt; ← C7 (+12V/fuse)&lt;br&gt;+ C8 band" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#EF9A9A;strokeWidth=2;align=left;spacingLeft=8;fontSize=11;" parent="1" vertex="1">
