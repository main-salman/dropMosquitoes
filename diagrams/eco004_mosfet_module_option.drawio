<mxfile host="app.diagrams.net" modified="2026-07-24T18:00:00.000Z" agent="Cursor" version="22.1.0">
  <diagram id="optionb" name="Option B cable map">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1580" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b style='font-size:22px;color:#0D47A1'&gt;ECO-004 Rev O — Option B CABLE MAP&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#333'&gt;Each row = one physical cable. Connect END A to END B. Power OFF + 12V unplugged first.&lt;/span&gt;" style="text;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="12" width="1100" height="44" as="geometry"/>
        </mxCell>

        <!-- ========== MASTER CABLE TABLE ========== -->
        <mxCell id="cable_table" value="&lt;b style='font-size:16px;color:#B71C1C'&gt;★ CONNECT THESE CABLES (after REMOVE list below)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table cellpadding='4' style='font-size:12px;color:#111;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#ECEFF1'&gt;&lt;td&gt;&lt;b&gt;#&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cable / part&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;END A (from)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;END B (to)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style='color:#0D47A1'&gt;C1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;USB-A ↔ Micro-B (data)&lt;/td&gt;&lt;td&gt;&lt;b&gt;Jetson USB-A port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Pico W micro-USB&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F5F5F5'&gt;&lt;td&gt;&lt;b style='color:#212121'&gt;C2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Black wire&lt;/td&gt;&lt;td&gt;&lt;b&gt;Pico GND pin&lt;/b&gt; (any GND: pin 3, 18, 23, 28, 33, or 38)&lt;/td&gt;&lt;td&gt;&lt;b&gt;GND bus&lt;/b&gt; (IDC40P T6 or T9 or T14 — same net)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style='color:#6A1B9A'&gt;C3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Purple/any + &lt;b&gt;220 Ω&lt;/b&gt; in series&lt;/td&gt;&lt;td&gt;&lt;b&gt;Pico GP15&lt;/b&gt; (physical pin 20)&lt;/td&gt;&lt;td&gt;&lt;b&gt;IRLB8721 Gate&lt;/b&gt; (left pin, label facing you)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F5F5F5'&gt;&lt;td&gt;&lt;b style='color:#F57F17'&gt;C4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;10 kΩ&lt;/b&gt; resistor (legs = the two ends)&lt;/td&gt;&lt;td&gt;&lt;b&gt;IRLB8721 Gate&lt;/b&gt; (same node as C3)&lt;/td&gt;&lt;td&gt;&lt;b&gt;GND bus&lt;/b&gt; (same as C2)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style='color:#212121'&gt;C5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Black/heavy wire&lt;/td&gt;&lt;td&gt;&lt;b&gt;IRLB8721 Source&lt;/b&gt; (right pin)&lt;/td&gt;&lt;td&gt;&lt;b&gt;GND bus&lt;/b&gt; (same as C2)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFEBEE'&gt;&lt;td&gt;&lt;b style='color:#C62828'&gt;C6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;MOVE&lt;/b&gt; BLUE solenoid wire&lt;/td&gt;&lt;td&gt;&lt;b&gt;Solenoid (−) BLUE&lt;/b&gt; terminal&lt;/td&gt;&lt;td&gt;&lt;b&gt;IRLB8721 Drain&lt;/b&gt; (middle pin) — was on module OUT−&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFEBEE'&gt;&lt;td&gt;&lt;b style='color:#B71C1C'&gt;C7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;MOVE&lt;/b&gt; RED solenoid wire + &lt;b&gt;3A fuse&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;+12V bus&lt;/b&gt; → fuse → &lt;/td&gt;&lt;td&gt;&lt;b&gt;Solenoid (+) RED&lt;/b&gt; — was on module OUT+&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b style='color:#E91E63'&gt;C8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;1N5408 diode&lt;/b&gt; (not a wire — legs)&lt;/td&gt;&lt;td&gt;&lt;b&gt;Band / cathode&lt;/b&gt; → Solenoid (+) RED / +12V side&lt;/td&gt;&lt;td&gt;&lt;b&gt;No-band / anode&lt;/b&gt; → Solenoid (−) BLUE / Drain side&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#555'&gt;C3 tip: wire from GP15 to one leg of 220Ω; other leg of 220Ω to Gate. C8 is &lt;b&gt;across&lt;/b&gt; the coil (parallel), not in series.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=3;align=left;spacingLeft=14;spacingRight=14;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="64" width="1100" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="remove_table" value="&lt;b style='font-size:14px;color:#FFFFFF'&gt;✕ UNPLUG THESE FIRST&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#FFCDD2'&gt;&lt;b&gt;R1&lt;/b&gt; Solenoid RED + BLUE off dual-MOS &lt;b&gt;OUT+ / OUT−&lt;/b&gt;&lt;br&gt;&lt;b&gt;R2&lt;/b&gt; Module &lt;b&gt;DC IN+ / DC IN−&lt;/b&gt; off 12V / CH2&lt;br&gt;&lt;b&gt;R3&lt;/b&gt; Wire &lt;b&gt;T36 → module SIG&lt;/b&gt; — remove both ends&lt;br&gt;&lt;b&gt;R4&lt;/b&gt; Wire &lt;b&gt;T29 → Relay IN B&lt;/b&gt; — remove (CH2 unused)&lt;br&gt;&lt;b&gt;KEEP&lt;/b&gt; &lt;b&gt;T11 → Relay IN A&lt;/b&gt; (pump) — do not touch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#7F0000;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="1160" y="64" width="400" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="pin_hint" value="&lt;b style='font-size:13px;color:#3E2723'&gt;IRLB8721 pins (label toward you)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#333'&gt;LEFT = &lt;b style='color:#6A1B9A'&gt;Gate&lt;/b&gt; (C3+C4)&lt;br&gt;MIDDLE = &lt;b style='color:#C62828'&gt;Drain&lt;/b&gt; (C6 BLUE)&lt;br&gt;RIGHT = &lt;b style='color:#212121'&gt;Source&lt;/b&gt; (C5 GND)&lt;br&gt;&lt;br&gt;&lt;b&gt;Pico GP15&lt;/b&gt; = pin 20&lt;br&gt;(right side, 5th from bottom if USB on top)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#5D4037;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="1160" y="236" width="400" height="148" as="geometry"/>
        </mxCell>

        <!-- ========== VISUAL LAYOUT ========== -->
        <mxCell id="vis_title" value="&lt;b style='font-size:16px;color:#0D47A1'&gt;Picture — follow the colored arrows (C1–C8)&lt;/b&gt;" style="text;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="400" width="600" height="28" as="geometry"/>
        </mxCell>

