                <mxCell id="sol" value="" style="rounded=1;fillColor=#263238;strokeColor=#FF6D00;shadow=1;arcSize=6;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="300" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="soll" value="&lt;b style='color:#FFB74D;font-size:14px'&gt;GOODRIG Solenoid&lt;/b&gt;&lt;br&gt;&lt;span style='color:#CFD8DC;font-size:10px'&gt;12V DC · 2A · 1/4&quot; NPT&lt;br&gt;direct-acting, normally closed&lt;br&gt;(+) RED → OUT+&lt;br&gt;(−) BLUE → OUT−&lt;/span&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="945" y="312" width="230" height="96" as="geometry"/>
                </mxCell>
