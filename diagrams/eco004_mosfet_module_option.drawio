        <mxCell id="jet" value="" style="rounded=1;fillColor=#1B5E20;strokeColor=#2E7D32;strokeWidth=2;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="440" width="200" height="220" as="geometry"/>
