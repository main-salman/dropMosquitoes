          <mxGeometry x="50" y="448" width="180" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="j_usb" value="&lt;b style='color:#BBDEFB'&gt;USB-A&lt;/b&gt;&lt;br&gt;&lt;span style='color:#90CAF9;font-size:10px'&gt;C1 starts here&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D47A1;strokeColor=#64B5F6;strokeWidth=3;align=center;" parent="1" vertex="1">
          <mxGeometry x="55" y="480" width="170" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="j_gnd" value="&lt;b style='color:#EEE'&gt;T6 / T9 / T14 GND&lt;/b&gt;&lt;br&gt;&lt;span style='color:#BDBDBD;font-size:10px'&gt;C2 · C4 · C5 land here&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#212121;strokeColor=#757575;strokeWidth=2;align=center;" parent="1" vertex="1">
          <mxGeometry x="55" y="536" width="170" height="44" as="geometry"/>
