        <mxCell id="j_12v" value="&lt;b style='color:#FFF'&gt;+12V bus&lt;/b&gt;&lt;br&gt;&lt;span style='color:#FFCDD2;font-size:10px'&gt;C7 starts here&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#EF9A9A;strokeWidth=2;align=center;" parent="1" vertex="1">
