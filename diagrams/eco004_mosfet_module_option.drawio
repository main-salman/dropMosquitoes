        <mxCell id="p_usb" value="&lt;b&gt;micro-USB&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;C1 ends here&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D47A1;strokeColor=#64B5F6;fontColor=#FFF;strokeWidth=2;align=center;" parent="1" vertex="1">
