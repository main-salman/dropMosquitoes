        </mxCell>
        <mxCell id="s_m" value="&lt;b style='color:#FFF'&gt;(−) BLUE&lt;/b&gt; → C6 Drain&lt;br&gt;+ C8 no-band" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D47A1;strokeColor=#64B5F6;strokeWidth=2;align=left;spacingLeft=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1140" y="540" width="200" height="44" as="geometry"/>
