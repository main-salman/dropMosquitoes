<mxfile>
  <diagram name="ECO-004 MOSFET Solenoid Circuit" id="eco004_circuit">
    <mxGraphModel dx="1400" dy="800" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;ECO-2026-004 Rev B: MOSFET Solenoid + Relay Gate Drive&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666;font-size:11px'&gt;BCM 27 → Relay CH2 control | Terminal 17 (+3.3V) → Relay B2 → IRLB8721 Gate → 12V Solenoid&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="820" height="45" as="geometry"/></mxCell>
        <!-- Jetson GPIO control -->
        <mxCell id="gpio" value="" style="rounded=1;fillColor=#1B5E20;strokeColor=#2E7D32;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="gpiolbl" value="&lt;b style='color:#A5D6A7;font-size:11px'&gt;Terminal 13&lt;/b&gt;&lt;br&gt;&lt;span style='color:#81C784;font-size:9px'&gt;BCM 27 GPIO&lt;br&gt;~1.5V HIGH OK&lt;br&gt;for relay IN&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="130" height="55" as="geometry"/></mxCell>
        <mxCell id="t17" value="" style="rounded=1;fillColor=#1565C0;strokeColor=#0D47A1;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="t17lbl" value="&lt;b style='color:#FFF;font-size:11px'&gt;Terminal 17&lt;/b&gt;&lt;br&gt;&lt;span style='color:#BBDEFB;font-size:9px'&gt;+3.3V fixed power&lt;br&gt;(NOT GPIO)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="248" width="130" height="40" as="geometry"/></mxCell>
        <!-- Relay CH2 -->
        <mxCell id="relay" value="" style="rounded=1;fillColor=#3E2723;strokeColor=#5D4037;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="120" width="180" height="175" as="geometry"/></mxCell>
        <mxCell id="relaylbl" value="&lt;b style='color:#BCAAA4;font-size:12px'&gt;Monk Makes CH2&lt;/b&gt;&lt;br&gt;&lt;span style='color:#A1887F;font-size:9px'&gt;IN B ← control&lt;br&gt;B1 ← +3.3V feed&lt;br&gt;B2 → Gate when ON&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="128" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="w_ctrl" value="" style="endArrow=block;endFill=1;strokeColor=#4CAF50;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="170" as="sourcePoint"/><mxPoint x="240" y="170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w_ctrl_lbl" value="&lt;span style='font-size:8px;color:#2E7D32'&gt;&lt;b&gt;GREEN&lt;/b&gt; control&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="188" y="148" width="70" height="18" as="geometry"/></mxCell>
        <mxCell id="w_33" value="" style="endArrow=block;endFill=1;strokeColor=#1565C0;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="267" as="sourcePoint"/><mxPoint x="240" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w_33_lbl" value="&lt;span style='font-size:8px;color:#1565C0'&gt;+3.3V → B1&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="188" y="275" width="70" height="16" as="geometry"/></mxCell>
        <mxCell id="w_b2" value="" style="endArrow=block;endFill=1;strokeColor=#7B1FA2;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="200" as="sourcePoint"/><mxPoint x="480" y="200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w_b2_lbl" value="&lt;span style='font-size:8px;color:#7B1FA2'&gt;B2 → Gate ~3.3V&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="178" width="90" height="16" as="geometry"/></mxCell>
        <!-- Optional pull-down -->
        <mxCell id="pd" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#FFB74D;shadow=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="260" width="90" height="50" as="geometry"/></mxCell>
        <mxCell id="pdlbl" value="&lt;b style='color:#E65100;font-size:9px'&gt;10kΩ opt.&lt;/b&gt;&lt;br&gt;&lt;span style='color:#BF360C;font-size:8px'&gt;Gate→GND&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="472" y="265" width="86" height="38" as="geometry"/></mxCell>
        <mxCell id="w_pd" value="" style="endArrow=none;strokeColor=#FFB74D;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="260" as="sourcePoint"/><mxPoint x="515" y="205" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w_pd_gnd" value="" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="310" as="sourcePoint"/><mxPoint x="515" y="375" as="targetPoint"/></mxGeometry></mxCell>
        <!-- MOSFET -->
        <mxCell id="mos" value="" style="rounded=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="180" height="140" as="geometry"/></mxCell>
        <mxCell id="mosicon" value="" style="rounded=0;fillColor=#3F51B5;strokeColor=#283593;" vertex="1" parent="1"><mxGeometry x="495" y="145" width="50" height="80" as="geometry"/></mxCell>
        <mxCell id="moslbl" value="&lt;b style='color:#283593;font-size:12px'&gt;IRLB8721PBF&lt;/b&gt;&lt;br&gt;&lt;span style='color:#3F51B5;font-size:9px'&gt;G←B2  D→Solenoid(−)&lt;br&gt;S→GND | Tab=D&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="545" y="130" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="w_s_gnd" value="" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="260" as="sourcePoint"/><mxPoint x="520" y="375" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="gnd1" value="&lt;b style='font-size:12px'&gt;⏚ GND&lt;/b&gt;" style="text;html=1;align=center;fontColor=#333;" vertex="1" parent="1"><mxGeometry x="490" y="375" width="50" height="20" as="geometry"/></mxCell>
        <!-- Solenoid + 12V -->
        <mxCell id="w_d_sol" value="" style="endArrow=block;endFill=1;strokeColor=#F44336;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="120" as="sourcePoint"/><mxPoint x="720" y="120" as="targetPoint"/><Array as="points"><mxPoint x="570" y="80"/><mxPoint x="720" y="80"/></Array></mxGeometry></mxCell>
        <mxCell id="sol" value="" style="rounded=1;fillColor=#263238;strokeColor=#37474F;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="sollbl" value="&lt;b style='color:#B0BEC5;font-size:11px'&gt;GOODRIG Solenoid&lt;/b&gt;&lt;br&gt;&lt;span style='color:#78909C;font-size:9px'&gt;12V NC | (+)→+12V&lt;br&gt;(−)→MOSFET Drain&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="130" width="150" height="45" as="geometry"/></mxCell>
        <mxCell id="v12" value="" style="rounded=1;fillColor=#F44336;strokeColor=#C62828;shadow=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="v12lbl" value="&lt;b style='color:#FFF;font-size:12px'&gt;+12V DC&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="882" y="68" width="106" height="25" as="geometry"/></mxCell>
        <mxCell id="w_12v" value="" style="endArrow=block;endFill=1;strokeColor=#F44336;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="100" as="sourcePoint"/><mxPoint x="870" y="100" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="diode" value="&lt;b style='color:#880E4F;font-size:10px'&gt;1N4007 flyback&lt;/b&gt;&lt;br&gt;&lt;span style='color:#AD1457;font-size:8px'&gt;across solenoid&lt;/span&gt;" style="rounded=1;fillColor=#FCE4EC;strokeColor=#E91E63;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="110" height="45" as="geometry"/></mxCell>
        <mxCell id="flow" value="&lt;b&gt;Signal Path (Rev B):&lt;/b&gt; BCM 27 HIGH → Relay CH2 closes → +3.3V on Gate → MOSFET conducts → 12V through solenoid coil → valve opens → GPIO LOW → relay opens → gate drops → valve closes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="920" height="40" as="geometry"/></mxCell>
        <mxCell id="timing" value="&lt;b&gt;⚡ Timing:&lt;/b&gt; Relay adds ~1–5ms; MOSFET still switches in &amp;lt;1μs once gate reaches 3.3V. Suitable for 10ms+ solenoid pulses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#333;fontSize=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="920" height="30" as="geometry"/></mxCell>
        <mxCell id="warn" value="&lt;b&gt;⚠ Do NOT&lt;/b&gt; wire Terminal 13 or Terminal 17 directly to MOSFET Gate. T13 is weak GPIO; T17 is always-on power." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6D00;fontColor=#333;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="920" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
