<mxfile>
  <diagram name="ECO-004 MOSFET Solenoid Circuit" id="eco004_circuit">
    <mxGraphModel dx="1400" dy="800" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="750" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;ECO-2026-004 Rev C: MOSFET Solenoid Switching&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666;font-size:11px'&gt;BCM 27 + 4.7kΩ pull-up (T17) → Gate → 12V Solenoid — Relay CH2 not used&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="780" height="45" as="geometry"/></mxCell>
        <mxCell id="gpio" value="" style="rounded=1;fillColor=#1B5E20;strokeColor=#2E7D32;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="150" height="90" as="geometry"/></mxCell>
        <mxCell id="gpiolbl" value="&lt;b style='color:#A5D6A7;font-size:11px'&gt;Terminal 13&lt;/b&gt;&lt;br&gt;&lt;span style='color:#81C784;font-size:9px'&gt;BCM 27 GPIO&lt;br&gt;GREEN → Gate&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="t17" value="" style="rounded=1;fillColor=#1565C0;strokeColor=#0D47A1;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="t17lbl" value="&lt;b style='color:#FFF;font-size:11px'&gt;Terminal 17&lt;/b&gt;&lt;br&gt;&lt;span style='color:#BBDEFB;font-size:9px'&gt;+3.3V via 4.7kΩ&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="248" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="w1" value="" style="endArrow=block;endFill=1;strokeColor=#4CAF50;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="175" as="sourcePoint"/><mxPoint x="350" y="190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="pu" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#FFB74D;shadow=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="100" height="55" as="geometry"/></mxCell>
        <mxCell id="pulbl" value="&lt;b style='color:#E65100;font-size:10px'&gt;4.7kΩ (472)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#BF360C;font-size:8px'&gt;T17 → Gate&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="282" y="238" width="96" height="38" as="geometry"/></mxCell>
        <mxCell id="w_pu" value="" style="endArrow=none;strokeColor=#1565C0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="267" as="sourcePoint"/><mxPoint x="280" y="257" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w_pu2" value="" style="endArrow=none;strokeColor=#FFB74D;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="230" as="sourcePoint"/><mxPoint x="330" y="195" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="mos" value="" style="rounded=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="120" width="180" height="140" as="geometry"/></mxCell>
        <mxCell id="moslbl" value="&lt;b style='color:#283593;font-size:12px'&gt;IRLB8721PBF&lt;/b&gt;&lt;br&gt;&lt;span style='color:#3F51B5;font-size:9px'&gt;G←green+4.7k D→Sol(−) S→GND&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="flow" value="&lt;b&gt;Signal Path:&lt;/b&gt; GPIO LOW → gate low → valve closed. GPIO HIGH/open → 4.7kΩ pulls gate to 3.3V → MOSFET ON → 12V through solenoid → water flows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="920" height="35" as="geometry"/></mxCell>
        <mxCell id="warn" value="&lt;b&gt;⚠&lt;/b&gt; Do NOT wire T17 directly to Gate (use 4.7kΩ). Do NOT use Relay CH2 for solenoid. Remove 100kΩ (104) pull-ups." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6D00;fontColor=#333;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="920" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
