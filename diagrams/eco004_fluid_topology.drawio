        <!-- FLOW + NOTES -->
        <mxCell id="flow" value="&lt;b&gt;As-built flow:&lt;/b&gt; Reservoir → Pump → &lt;b style='color:#C62828'&gt;Feelers 1/4&amp;quot; check valve (arrow toward tank)&lt;/b&gt; → uxcell → Accumulator → uxcell → brass tee + AUTEX transducer → silicone to turret → Kozelo → Solenoid → Nozzle (direct).&lt;br&gt;&lt;b style='color:#B71C1C'&gt;Why the check valve:&lt;/b&gt; pump internal valves leak when OFF — external one-way traps pressure in accumulator + tee + solenoid inlet. &lt;b&gt;Do not&lt;/b&gt; put a check valve between accumulator and solenoid (blocks the shot)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#333;fontSize=11;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="320" width="1560" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="verify" value="&lt;b style='color:#1B5E20'&gt;Verify hold:&lt;/b&gt; charge to Target PSI → stop pump → solenoid CLOSED → transducer PSI must stay flat (no bleed-back through pump)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#333;fontSize=11;strokeWidth=2;align=left;spacingLeft=12;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="40" y="405" width="1560" height="36" as="geometry"/>
        </mxCell>

