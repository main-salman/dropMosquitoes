<mxfile>
  <diagram name="ECO-004 Fluid Topology" id="eco004_fluid">
    <mxGraphModel dx="1800" dy="900" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Title -->
        <mxCell id="t1" value="&lt;b style='font-size:20px'&gt;ECO-2026-004: Constant-Pressure Accumulator + Solenoid Fluid Path&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666;font-size:12px'&gt;Reservoir → Pump (continuous) → Accumulator (dampens pulsation) → Solenoid (MOSFET-gated) → Nozzle&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="900" height="50" as="geometry"/></mxCell>
        <!-- ===== 1. RESERVOIR ===== -->
        <mxCell id="res" value="" style="rounded=1;fillColor=#E3F2FD;strokeColor=#90CAF9;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="130" height="130" as="geometry"/></mxCell>
        <mxCell id="reswater" value="" style="rounded=0;fillColor=#42A5F5;strokeColor=#1E88E5;opacity=50;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="110" height="80" as="geometry"/></mxCell>
        <mxCell id="reslbl" value="&lt;b style='color:#1565C0;font-size:11px'&gt;Water Reservoir&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1976D2;font-size:8px'&gt;Shallow tote + mesh lid&lt;br&gt;Gravity-fed intake&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="45" y="125" width="120" height="35" as="geometry"/></mxCell>
