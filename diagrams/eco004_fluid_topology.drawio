        <mxCell id="a67l" value="&lt;span style='font-size:7px;color:#E65100'&gt;threads into&lt;br&gt;1/4&amp;quot; FNPT&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="947" y="156" width="48" height="22" as="geometry"/></mxCell>
