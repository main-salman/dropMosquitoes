        <mxCell id="a12l" value="&lt;span style='font-size:8px;color:#42A5F5'&gt;1/4&amp;quot; silicone&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="170" y="165" width="60" height="14" as="geometry"/></mxCell>
