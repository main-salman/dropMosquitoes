        <mxCell id="sollbl" value="&lt;b style='color:#B0BEC5;font-size:11px'&gt;GOODRIG Solenoid&lt;/b&gt;&lt;br&gt;&lt;span style='color:#78909C;font-size:8px'&gt;12V DC Direct-Acting NC&lt;br&gt;1/4&amp;quot; FNPT both ends&lt;br&gt;MOSFET-gated (BCM 27)&lt;br&gt;&lt;b style='color:#4CAF50'&gt;⚡ Sub-ms switching&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="1015" y="185" width="130" height="55" as="geometry"/></mxCell>
        <mxCell id="solcap" value="&lt;b&gt;4. Solenoid Valve&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;precision fluid gate&lt;/span&gt;" style="text;html=1;fontSize=10;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="1015" y="280" width="130" height="28" as="geometry"/></mxCell>
