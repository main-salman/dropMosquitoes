        <mxCell id="pumpcap" value="&lt;b&gt;2. Pump&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;runs continuous — no pulsing&lt;/span&gt;" style="text;html=1;fontSize=10;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="225" y="250" width="130" height="28" as="geometry"/></mxCell>
