        <!-- ===== FLOW SUMMARY ===== -->
        <mxCell id="flow" value="&lt;b&gt;Flow:&lt;/b&gt; Reservoir → Pump (continuous, 60 PSI) → uxcell 1/2&amp;quot; FNPT adapter → &lt;b&gt;Accumulator&lt;/b&gt; (absorbs pulsation) → uxcell 1/2&amp;quot; FNPT adapter → Kozelo 1/4&amp;quot; MNPT adapter → &lt;b&gt;Solenoid&lt;/b&gt; (MOSFET-gated, sub-ms) → Kozelo 1/4&amp;quot; MNPT adapter → Nozzle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#2196F3;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1450" height="35" as="geometry"/></mxCell>
        <!-- Legend -->
        <mxCell id="leg" value="&lt;b style='font-size:10px'&gt;Thread Adapter Legend:&lt;/b&gt;&lt;br&gt;&lt;span style='color:#F57F17'&gt;■&lt;/span&gt; Yellow = uxcell (1/4&amp;quot; Barb × 1/2&amp;quot; FNPT) — connects to Accumulator 1/2&amp;quot; MNPT ports&lt;br&gt;&lt;span style='color:#E65100'&gt;■&lt;/span&gt; Orange = Kozelo (1/4&amp;quot; Barb × 1/4&amp;quot; MNPT) — threads into Solenoid 1/4&amp;quot; FNPT ports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FDD835;fontColor=#333;fontSize=9;strokeWidth=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="600" height="55" as="geometry"/></mxCell>
