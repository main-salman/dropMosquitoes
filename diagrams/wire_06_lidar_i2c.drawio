<mxfile>
  <diagram name="LiDAR I2C" id="lidar1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#1a1a2e">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;WIRE DIAGRAM 06: TF-Luna LiDAR (I2C)&lt;/b&gt;&lt;br&gt;Jetson I2C Bus 1 → TF-Luna module (addr 0x10)" style="text;html=1;fontSize=16;fontColor=#E0E0E0;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="50" as="geometry"/></mxCell>
        <mxCell id="jet" value="&lt;b&gt;Jetson GPIO Header&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Pin 3 = I2C SDA (Bus 1)&lt;br&gt;&lt;font color='#2196F3'&gt;BLUE jumper wire&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pin 5 = I2C SCL (Bus 1)&lt;br&gt;&lt;font color='#FFEB3B'&gt;YELLOW jumper wire&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pin 1 = 3.3V Power&lt;br&gt;&lt;font color='#F44336'&gt;RED jumper wire&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pin 9 = GND&lt;br&gt;&lt;font color='#666'&gt;BLACK jumper wire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#4CAF50;fontColor=#FFF;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="250" as="geometry"/></mxCell>
        <mxCell id="lid" value="&lt;b&gt;Benewake TF-Luna&lt;/b&gt;&lt;br&gt;LiDAR ToF Sensor&lt;br&gt;&lt;hr&gt;SDA — Data line&lt;br&gt;SCL — Clock line&lt;br&gt;VCC — 3.3V–5V&lt;br&gt;GND — Ground&lt;br&gt;&lt;hr&gt;Range: 0.2–8.0m&lt;br&gt;Addr: 0x10&lt;br&gt;250Hz update rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006064;strokeColor=#00BCD4;fontColor=#FFF;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="200" height="250" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;font color='#2196F3'&gt;BLUE: Pin 3 SDA → TF-Luna SDA&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2196F3;strokeWidth=3;fontSize=10;exitX=1;exitY=0.2;entryX=0;entryY=0.25;" edge="1" parent="1" source="jet" target="lid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;font color='#FFEB3B'&gt;YELLOW: Pin 5 SCL → TF-Luna SCL&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FFEB3B;strokeWidth=3;fontSize=10;exitX=1;exitY=0.4;entryX=0;entryY=0.42;" edge="1" parent="1" source="jet" target="lid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;font color='#F44336'&gt;RED: Pin 1 (3.3V) → TF-Luna VCC&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F44336;strokeWidth=3;fontSize=10;exitX=1;exitY=0.6;entryX=0;entryY=0.6;" edge="1" parent="1" source="jet" target="lid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="&lt;font color='#888'&gt;BLACK: Pin 9 GND → TF-Luna GND&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555;strokeWidth=3;fontSize=10;exitX=1;exitY=0.8;entryX=0;entryY=0.78;" edge="1" parent="1" source="jet" target="lid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="Mount: Co-axial with Sniper camera on gimbal payload plate. Points same direction as camera." style="text;html=1;fontSize=11;fontColor=#4DD0E1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value="I2C address 0x10 is default. Verify with: i2cdetect -y 1" style="text;html=1;fontSize=11;fontColor=#FF9800;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="400" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
