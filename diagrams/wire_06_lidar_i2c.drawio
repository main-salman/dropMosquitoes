<mxfile host="65bd71144e">
    <diagram name="LiDAR I2C" id="lidar1">
        <mxGraphModel dx="982" dy="637" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t1" value="&lt;b&gt;WIRE DIAGRAM 06: TF-Luna LiDAR (I2C) — UPDATED&lt;/b&gt;&lt;br&gt;5 wires: SDA, SCL, 5V, GND, and CFG→GND" style="text;html=1;fontSize=16;fontColor=#E0E0E0;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="jet" value="&lt;b&gt;Jetson GPIO Header&lt;/b&gt;&lt;hr&gt;Pin 3 = I2C SDA (Bus 1)&lt;br&gt;&lt;font color='#2196F3'&gt;BLUE jumper wire&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pin 5 = I2C SCL (Bus 1)&lt;br&gt;&lt;font color='#FFEB3B'&gt;YELLOW jumper wire&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pin 2 or 4 = 5V Power&lt;br&gt;&lt;font color='#F44336'&gt;RED jumper wire&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pin 6 = GND&lt;br&gt;&lt;font color='#666'&gt;BLACK jumper wire&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pin 9 = GND (for CFG)&lt;br&gt;&lt;font color='#4CAF50'&gt;GREEN jumper wire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#4CAF50;fontColor=#FFF;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="220" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="lid" value="&lt;b&gt;Benewake TF-Luna&lt;/b&gt;&lt;br&gt;LiDAR ToF Sensor&lt;hr&gt;Pin 1: VCC (5V)&lt;br&gt;Pin 2: SDA (3.3V LVTTL)&lt;br&gt;Pin 3: SCL (3.3V LVTTL)&lt;br&gt;Pin 4: GND&lt;br&gt;&lt;font color='#FF4081'&gt;&lt;b&gt;Pin 5: CFG → GND&lt;/b&gt;&lt;/font&gt;&lt;hr&gt;Range: 0.2–8.0m&lt;br&gt;Addr: 0x10&lt;br&gt;250Hz update rate&lt;br&gt;I2C logic: 3.3V ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006064;strokeColor=#00BCD4;fontColor=#FFF;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="520" y="100" width="220" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="&lt;font color='#2196F3'&gt;BLUE: Pin 3 SDA → TF-Luna Pin 2 SDA&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2196F3;strokeWidth=3;fontSize=10;exitX=1;exitY=0.15;entryX=0;entryY=0.2;" parent="1" source="jet" target="lid" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="&lt;font color='#FFEB3B'&gt;YELLOW: Pin 5 SCL → TF-Luna Pin 3 SCL&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FFEB3B;strokeWidth=3;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.35;" parent="1" source="jet" target="lid" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="&lt;font color='#F44336'&gt;RED: Pin 2/4 (5V) → TF-Luna Pin 1 VCC&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F44336;strokeWidth=3;fontSize=10;exitX=1;exitY=0.48;entryX=0;entryY=0.5;" parent="1" source="jet" target="lid" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="&lt;font color='#888'&gt;BLACK: Pin 6 GND → TF-Luna Pin 4 GND&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555;strokeWidth=3;fontSize=10;exitX=1;exitY=0.63;entryX=0;entryY=0.65;" parent="1" source="jet" target="lid" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="&lt;font color='#4CAF50'&gt;&lt;b&gt;GREEN: Pin 9 GND → TF-Luna Pin 5 CFG&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4CAF50;strokeWidth=4;fontSize=10;exitX=1;exitY=0.8;entryX=0;entryY=0.8;" parent="1" source="jet" target="lid" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="warn" value="⚠ CRITICAL: TF-Luna Pin 5 (CFG) MUST be connected to GND to enable I2C mode.&lt;br&gt;If left floating, the sensor defaults to UART mode and will NOT respond on I2C bus.&lt;br&gt;&lt;br&gt;✅ I2C logic level is 3.3V LVTTL — directly compatible with Jetson. No level shifter needed.&lt;br&gt;✅ Power from 5V pin (NOT 3.3V)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A1C1C;strokeColor=#FF4081;fontColor=#FF8A80;fontSize=11;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="470" width="700" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="Verify: i2cdetect -y 1  (should show 0x10 in the grid)" style="text;html=1;fontSize=11;fontColor=#FF9800;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="590" width="400" height="30" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>