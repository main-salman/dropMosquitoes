        <mxCell id="e2l" value="&lt;span style='color:#F9A825;font-size:10px'&gt;&lt;b&gt;YELLOW&lt;/b&gt; SCL&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="252" width="90" height="16" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="endArrow=block;endFill=1;strokeColor=#D32F2F;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="213" as="sourcePoint"/><mxPoint x="545" y="233" as="targetPoint"/><Array as="points"><mxPoint x="400" y="213"/><mxPoint x="400" y="280"/><mxPoint x="545" y="280"/></Array></mxGeometry></mxCell>
        <mxCell id="e3l" value="&lt;span style='color:#D32F2F;font-size:10px'&gt;&lt;b&gt;RED&lt;/b&gt; 5V Power&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="275" width="100" height="16" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#777;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="243" as="sourcePoint"/><mxPoint x="635" y="233" as="targetPoint"/><Array as="points"><mxPoint x="430" y="243"/><mxPoint x="430" y="295"/><mxPoint x="635" y="295"/></Array></mxGeometry></mxCell>
        <mxCell id="e4l" value="&lt;span style='color:#555;font-size:10px'&gt;&lt;b&gt;BLACK&lt;/b&gt; GND&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="292" width="80" height="16" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="endArrow=block;endFill=1;strokeColor=#4CAF50;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="273" as="sourcePoint"/><mxPoint x="680" y="233" as="targetPoint"/><Array as="points"><mxPoint x="460" y="273"/><mxPoint x="460" y="310"/><mxPoint x="680" y="310"/></Array></mxGeometry></mxCell>
        <mxCell id="e5l" value="&lt;span style='color:#388E3C;font-size:10px'&gt;&lt;b&gt;GREEN&lt;/b&gt; CFG→GND&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="308" width="120" height="16" as="geometry"/></mxCell>
        <!-- CRITICAL -->
        <mxCell id="warn" value="⚠ &lt;b&gt;CRITICAL:&lt;/b&gt; TF-Luna Pin 5 (CFG) MUST connect to GND (Terminal 9) for I2C mode. If floating → defaults to UART!&lt;br&gt;✅ I2C logic = 3.3V LVTTL — directly compatible with Jetson. No level shifter. Power from 5V (Terminal 4)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6D00;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="700" height="50" as="geometry"/></mxCell>
        <mxCell id="eco" value="&lt;b&gt;ECO-2026-002:&lt;/b&gt; All wires connect to &lt;b&gt;IDC40P screw terminals&lt;/b&gt;, not Jetson GPIO header directly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#333;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="700" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
