<mxfile>
  <diagram name="LiDAR I2C" id="lidar_v3">
    <mxGraphModel dx="1400" dy="900" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b style='font-size:18px;color:#333'&gt;WIRE 06: TF-Luna LiDAR (I2C via Terminal Block)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;5 wires from IDC40P screw terminals: SDA, SCL, 5V, GND, CFG→GND&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="650" height="45" as="geometry"/></mxCell>
        <!-- IDC40P Terminal Block -->
        <mxCell id="idc" value="" style="rounded=1;fillColor=#1B5E20;strokeColor=#4CAF50;shadow=1;arcSize=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="250" as="geometry"/></mxCell>
        <mxCell id="idclbl" value="&lt;b style='color:#A5D6A7;font-size:12px'&gt;IDC40P Terminal Block&lt;/b&gt;&lt;br&gt;&lt;span style='color:#81C784;font-size:8px'&gt;Screw terminal breakout&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="55" y="108" width="170" height="25" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#64B5F6'&gt;T3&lt;/b&gt; I2C SDA&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="160" height="16" as="geometry"/></mxCell>
        <mxCell id="t5" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#FDD835'&gt;T5&lt;/b&gt; I2C SCL&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="175" width="160" height="16" as="geometry"/></mxCell>
        <mxCell id="t4" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#EF5350'&gt;T4&lt;/b&gt; 5V Power&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="205" width="160" height="16" as="geometry"/></mxCell>
        <mxCell id="t6" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b style='color:#BDBDBD'&gt;T6&lt;/b&gt; GND&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55" y="235" width="160" height="16" as="geometry"/></mxCell>
