        <mxCell id="gpiot" value="&lt;b style='color:#4CAF50;font-size:11px'&gt;Jetson I2C Bus 1&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="108" width="140" height="15" as="geometry"/></mxCell>
