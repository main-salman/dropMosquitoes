        <mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#555;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="218" as="sourcePoint"/><mxPoint x="620" y="213" as="targetPoint"/><Array as="points"><mxPoint x="370" y="218"/><mxPoint x="370" y="275"/><mxPoint x="620" y="275"/></Array></mxGeometry></mxCell>
        <mxCell id="e4l" value="&lt;span style='color:#555;font-size:10px'&gt;&lt;b&gt;BLACK&lt;/b&gt; GND&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="258" y="270" width="80" height="16" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="endArrow=block;endFill=1;strokeColor=#4CAF50;strokeWidth=4;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="243" as="sourcePoint"/><mxPoint x="660" y="213" as="targetPoint"/><Array as="points"><mxPoint x="390" y="243"/><mxPoint x="390" y="290"/><mxPoint x="660" y="290"/></Array></mxGeometry></mxCell>
        <mxCell id="e5l" value="&lt;span style='color:#4CAF50;font-size:10px'&gt;&lt;b&gt;GREEN&lt;/b&gt; CFG→GND&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="258" y="285" width="120" height="16" as="geometry"/></mxCell>
        <!-- CRITICAL -->
        <mxCell id="warn" value="⚠ &lt;b&gt;CRITICAL:&lt;/b&gt; TF-Luna Pin 5 (CFG) MUST connect to GND for I2C mode. If floating → defaults to UART → won't respond!&lt;br&gt;✅ I2C logic = 3.3V LVTTL — directly compatible with Jetson. No level shifter. Power from 5V pin (NOT 3.3V)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6D00;fontColor=#333;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="660" height="55" as="geometry"/></mxCell>
