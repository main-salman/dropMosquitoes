        <mxCell id="p6" value="&lt;span style='font-size:9px;color:#DDD'&gt;&lt;b style='color:#888'&gt;Pin 6&lt;/b&gt; GND&lt;/span&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="120" height="16" as="geometry"/></mxCell>
