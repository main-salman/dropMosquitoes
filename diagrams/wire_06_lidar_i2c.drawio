        <!-- TF-Luna -->
        <mxCell id="luna" value="" style="rounded=1;fillColor=#006064;strokeColor=#00838F;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="220" height="250" as="geometry"/></mxCell>
        <mxCell id="lunalens" value="" style="ellipse;fillColor=#111;strokeColor=#00BCD4;" vertex="1" parent="1"><mxGeometry x="570" y="125" width="45" height="45" as="geometry"/></mxCell>
        <mxCell id="lunair" value="" style="ellipse;fillColor=#880E4F;strokeColor=#AD1457;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="585" y="140" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="lunarx" value="" style="ellipse;fillColor=#111;strokeColor=#00BCD4;" vertex="1" parent="1"><mxGeometry x="625" y="128" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="lunalbl" value="&lt;b style='color:#4DD0E1;font-size:14px'&gt;Benewake&lt;/b&gt;&lt;br&gt;&lt;span style='color:#00BCD4;font-size:10px'&gt;TF-Luna LiDAR&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="180" width="160" height="28" as="geometry"/></mxCell>
        <mxCell id="lunapins" value="" style="rounded=0;fillColor=#2E7D32;strokeColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="540" y="225" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="lunapinlbl" value="&lt;span style='font-size:8px;color:#FFF'&gt;VCC &amp;nbsp; SDA &amp;nbsp; SCL &amp;nbsp; GND &amp;nbsp; &lt;b&gt;CFG&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="540" y="226" width="170" height="16" as="geometry"/></mxCell>
        <mxCell id="lunaspec" value="&lt;span style='color:#4DD0E1;font-size:9px'&gt;Range: 0.2–8.0m | Addr: 0x10&lt;br&gt;I2C logic: 3.3V ✓ | 250Hz&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="255" width="170" height="25" as="geometry"/></mxCell>
        <mxCell id="lunacap" value="&lt;b style='color:#333'&gt;TF-Luna LiDAR&lt;/b&gt;&lt;br&gt;&lt;span style='color:#888;font-size:10px'&gt;co-axial with sniper camera on gimbal&lt;/span&gt;" style="text;html=1;fontSize=11;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="220" height="30" as="geometry"/></mxCell>
        <!-- Wires -->
        <mxCell id="e1" value="" style="endArrow=block;endFill=1;strokeColor=#2196F3;strokeWidth=3;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="153" as="sourcePoint"/><mxPoint x="565" y="233" as="targetPoint"/><Array as="points"><mxPoint x="340" y="153"/><mxPoint x="340" y="233"/></Array></mxGeometry></mxCell>
        <mxCell id="e1l" value="&lt;span style='color:#1976D2;font-size:10px'&gt;&lt;b&gt;BLUE&lt;/b&gt; SDA&lt;/span&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="135" width="75" height="16" as="geometry"/></mxCell>
