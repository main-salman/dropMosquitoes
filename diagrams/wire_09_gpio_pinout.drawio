        <mxCell id="summary" value="&lt;b&gt;10 pins used:&lt;/b&gt; 2 (5V), 3 (SDA), 5 (SCL), 6 (GND), 8 (TX), 9 (GND/CFG), 10 (RX), 12 (GPIO18), 14 (GND), 18 (GPIO24), 20 (GND)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#333;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="500" width="500" height="30" as="geometry"/></mxCell>
