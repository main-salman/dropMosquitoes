        <mxCell id="r2" value="&lt;span style='font-size:9px;color:#DDD'&gt;&lt;b&gt;2&lt;/b&gt; &lt;b style='color:#D32F2F'&gt;5V → LiDAR VCC&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="150" height="14" as="geometry"/></mxCell>
