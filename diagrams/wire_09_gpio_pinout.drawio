<mxfile>
  <diagram name="GPIO Pinout" id="gpio_v3">
    <mxGraphModel dx="1300" dy="1000" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b style='font-size:18px;color:#333'&gt;WIRE 09: GPIO → IDC40P Terminal Mapping&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;All pins routed via 40-pin ribbon cable to screw terminal breakout (ECO-2026-002)&lt;/span&gt;" style="text;html=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="700" height="45" as="geometry"/></mxCell>
        <!-- GPIO Header -->
        <mxCell id="hdr" value="" style="rounded=0;fillColor=#1B1B1B;strokeColor=#333;shadow=1;" vertex="1" parent="1"><mxGeometry x="200" y="80" width="320" height="530" as="geometry"/></mxCell>
        <mxCell id="hdrt" value="&lt;b style='color:#4CAF50;font-size:14px'&gt;IDC40P Screw Terminal Block&lt;/b&gt;&lt;br&gt;&lt;span style='color:#81C784;font-size:9px'&gt;(mirrors Jetson 40-pin header 1:1)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="220" y="88" width="280" height="28" as="geometry"/></mxCell>
        <!-- Pin pairs -->
        <mxCell id="r1" value="&lt;span style='font-size:10px;color:#EEE'&gt;3.3V &lt;b&gt;1&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="210" y="130" width="110" height="16" as="geometry"/></mxCell>
