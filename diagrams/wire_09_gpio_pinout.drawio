        <!-- Legend -->
        <mxCell id="leg" value="&lt;b style='color:#333;font-size:11px'&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style='color:#EF5350;font-size:10px'&gt;■&lt;/span&gt;&lt;span style='color:#333;font-size:10px'&gt; 5V Power&lt;/span&gt;&lt;br&gt;&lt;span style='color:#64B5F6;font-size:10px'&gt;■&lt;/span&gt;&lt;span style='color:#333;font-size:10px'&gt; I2C / UART Data&lt;/span&gt;&lt;br&gt;&lt;span style='color:#FBC02D;font-size:10px'&gt;■&lt;/span&gt;&lt;span style='color:#333;font-size:10px'&gt; GPIO Output (signal)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#FF9800;font-size:10px'&gt;■&lt;/span&gt;&lt;span style='color:#333;font-size:10px'&gt; GPIO Output (signal)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#66BB6A;font-size:10px'&gt;■&lt;/span&gt;&lt;span style='color:#333;font-size:10px'&gt; GND (for mode select)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#777;font-size:10px'&gt;■&lt;/span&gt;&lt;span style='color:#333;font-size:10px'&gt; GND (power return)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDD;fontColor=#333;fontSize=10;align=left;spacingLeft=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="150" height="130" as="geometry"/></mxCell>
        <!-- Summary -->
        <mxCell id="summary" value="&lt;b style='color:#333;font-size:11px'&gt;12 terminals active:&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555;font-size:10px'&gt;T2 (5V), T3 (SDA), T4 (5V), T5 (SCL), T6 (GND), T8 (TX),&lt;br&gt;T9 (GND+CFG), T10 (RX), T11 (BCM17), T13 (BCM27), T14 (GND)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#333;fontSize=10;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="210" y="530" width="420" height="55" as="geometry"/></mxCell>
        <mxCell id="eco" value="&lt;b&gt;ECO-2026-002:&lt;/b&gt; Relay pins changed from BCM18/24 → &lt;b&gt;BCM17/27&lt;/b&gt; (Pin 11/13). Old Pin 12/18 freed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6D00;fontColor=#333;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="210" y="600" width="420" height="30" as="geometry"/></mxCell>
