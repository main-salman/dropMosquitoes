        <!-- Pin 18 -->
        <mxCell id="r17" value="&lt;span style='font-size:9px;color:#666'&gt;17&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="280" y="340" width="20" height="14" as="geometry"/></mxCell>
