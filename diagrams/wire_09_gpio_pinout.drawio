        <mxCell id="r2" value="&lt;span style='font-size:10px;color:#EEE'&gt;&lt;b&gt;2&lt;/b&gt; &lt;b style='color:#EF5350'&gt;5V → RELAY V+&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="180" height="16" as="geometry"/></mxCell>
