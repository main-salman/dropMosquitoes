        <mxCell id="diode_lbl" value="&lt;span style='color:#F8FAFC;font-size:9px'&gt;&lt;b&gt;1N4007&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
