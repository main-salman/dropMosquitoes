            <mxPoint x="430" y="420" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="915" y="310"/>
              <mxPoint x="760" y="310"/>
              <mxPoint x="760" y="470"/>
              <mxPoint x="400" y="470"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="wire_pump_gnd_lbl" value="GND Return" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#F8FAFC;fontSize=8;backgroundColor=#0F172A;" vertex="1" connectable="0" parent="wire_pump_gnd">
          <mxGeometry x="-0.7" relative="1" as="geometry">
            <mxPoint x="0" y="0" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- 10. Gimbal GND to Wago GND Port 5 -->
        <mxCell id="wire_gimbal_gnd" value="" style="endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=3;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="gimbal" target="wago_gnd">
