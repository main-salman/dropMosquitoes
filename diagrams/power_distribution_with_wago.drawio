          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="290" as="sourcePoint"/>
            <mxPoint x="840" y="230" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="780" y="290"/>
              <mxPoint x="780" y="235"/>
