        <mxCell id="wire_gnd_relay_lbl" value="Relay GND" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#F8FAFC;fontSize=8;backgroundColor=#0F172A;" vertex="1" connectable="0" parent="wire_gnd_relay">
