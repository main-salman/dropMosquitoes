          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="0" y="0" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- =================== GPIO LOGIC CONNECTIONS =================== -->

        <!-- 13. IDC Terminal 11 (BCM 17) Yellow wire to IN1 on Relay -->
        <mxCell id="wire_idc_in1" value="" style="endArrow=block;endFill=1;strokeColor=#FBBF24;strokeWidth=2.5;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="idc" target="relay">
          <mxGeometry relative="1" as="geometry">
