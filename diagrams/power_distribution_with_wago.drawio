            <Array as="points">
              <mxPoint x="345" y="500"/>
              <mxPoint x="490" y="500"/>
              <mxPoint x="490" y="380"/>
              <mxPoint x="520" y="380"/>
            </Array>
          </mxGeometry>
        </mxCell>
