        <mxCell id="gimbal_lbl" value="&lt;b style='color:#F8FAFC;font-size:12px'&gt;Storm32 Gimbal&lt;/b&gt;&lt;br&gt;&lt;span style='color:#94A3B8;font-size:9px'&gt;Turret Controller &amp; Gimbal&lt;br&gt;&lt;span style='color:#F472B6'&gt;[Switchable via CH2]&lt;/span&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="gimbal">
          <mxGeometry x="5" y="10" width="140" height="60" as="geometry"/>
