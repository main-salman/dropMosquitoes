  <diagram name="Power &amp; Control Logic" id="power_wago_logic">
    <mxGraphModel dx="1420" dy="850" grid="1" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" background="#0F172A">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Schematic Title -->
        <mxCell id="title" value="&lt;b style='font-size:20px;color:#F8FAFC'&gt;Autonomous Mosquito Sentry System&lt;/b&gt;&lt;br&gt;&lt;span style='color:#94A3B8;font-size:12px'&gt;Power &amp; Control Logic Schematic (Wago 221-415 Hubs, GPIO Breakout &amp; Flyback Protection)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="60" as="geometry"/>
        </mxCell>

        <!-- 1. Central Power Supply -->
        <mxCell id="ps" value="" style="rounded=1;fillColor=#1E293B;strokeColor=#475569;strokeWidth=2;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="130" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ps_lbl" value="&lt;b style='color:#F8FAFC;font-size:12px'&gt;Central Power&lt;/b&gt;&lt;br&gt;&lt;span style='color:#E2E8F0;font-size:10px'&gt;12V 5A DC&lt;br&gt;Power Supply&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="ps">
          <mxGeometry x="5" y="10" width="120" height="80" as="geometry"/>
        </mxCell>

        <!-- 2. Wago +12V Bus -->
        <mxCell id="wago_pos" value="" style="rounded=1;fillColor=#1E293B;strokeColor=#EF4444;strokeWidth=3;shadow=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="140" width="150" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="wago_pos_lbl" value="&lt;b style='color:#EF4444;font-size:12px'&gt;+12V WAGO BUS&lt;/b&gt;&lt;br&gt;&lt;span style='color:#94A3B8;font-size:9px'&gt;Wago 221-415 (5-Port)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#E2E8F0;font-size:8px'&gt;1: +12V Input&lt;br&gt;2: To Jetson Nano&lt;br&gt;3: To Relay V+ Inputs&lt;br&gt;4: [Spare]&lt;br&gt;5: [Spare]&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="wago_pos">
          <mxGeometry x="5" y="5" width="140" height="100" as="geometry"/>
        </mxCell>

        <!-- 3. Wago GND Bus -->
        <mxCell id="wago_gnd" value="" style="rounded=1;fillColor=#1E293B;strokeColor=#64748B;strokeWidth=3;shadow=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="340" width="150" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="wago_gnd_lbl" value="&lt;b style='color:#38BDF8;font-size:12px'&gt;GND WAGO BUS&lt;/b&gt;&lt;br&gt;&lt;span style='color:#94A3B8;font-size:9px'&gt;Wago 221-415 (5-Port)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#E2E8F0;font-size:8px'&gt;1: GND Input&lt;br&gt;2: To Jetson Nano GND&lt;br&gt;3: To Relay logic GND&lt;br&gt;4: From Pump GND&lt;br&gt;5: From Gimbal GND&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="wago_gnd">
          <mxGeometry x="5" y="5" width="140" height="100" as="geometry"/>
        </mxCell>

        <!-- 4. Jetson Orin Nano Super Mini PC -->
        <mxCell id="jetson" value="" style="rounded=1;fillColor=#0F172A;strokeColor=#10B981;strokeWidth=2;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="jetson_lbl" value="&lt;b style='color:#10B981;font-size:12px'&gt;Jetson Orin Nano&lt;/b&gt;&lt;br&gt;&lt;span style='color:#E2E8F0;font-size:10px'&gt;Super Mini PC&lt;br&gt;&lt;b style='color:#34D399'&gt;(Always-On Bypass)&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="jetson">
          <mxGeometry x="5" y="10" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- 5. Monk Makes Dual Relay Module -->
        <mxCell id="relay" value="" style="rounded=1;fillColor=#1E293B;strokeColor=#F43F5E;strokeWidth=2;shadow=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="250" width="200" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="relay_lbl" value="&lt;b style='color:#F43F5E;font-size:12px'&gt;Monk Makes Dual Relay&lt;/b&gt;&lt;br&gt;&lt;span style='color:#94A3B8;font-size:9px'&gt;Power Switched Outputs&lt;/span&gt;&lt;br&gt;&lt;hr style='border-color:#475569;margin:5px 0;'&gt;&lt;span style='color:#E2E8F0;font-size:9px;text-align:left;display:block;'&gt;• IN1 (Trigger Channel 1 - Pump)&lt;br&gt;• IN2 (Trigger Channel 2 - Gimbal)&lt;br&gt;• GND (Common Logic Ground)&lt;br&gt;&lt;br&gt;• CH1 Switch: Cuts Positive (+) Pump Line&lt;br&gt;• CH2 Switch: Cuts Positive (+) Gimbal Line&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="relay">
          <mxGeometry x="5" y="5" width="190" height="190" as="geometry"/>
        </mxCell>

        <!-- 6. IDC40P 40-Pin Breakout Terminal Block -->
        <mxCell id="idc" value="" style="rounded=1;fillColor=#1E293B;strokeColor=#F59E0B;strokeWidth=2;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="540" width="210" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="idc_lbl" value="&lt;b style='color:#F59E0B;font-size:12px'&gt;IDC40P Breakout Block&lt;/b&gt;&lt;br&gt;&lt;span style='color:#94A3B8;font-size:9px'&gt;Jetson GPIO Extension Hub&lt;/span&gt;&lt;br&gt;&lt;hr style='border-color:#475569;margin:5px 0;'&gt;&lt;span style='color:#FBBF24;font-size:10px;text-align:left;display:block;'&gt;• Terminal 11 (BCM 17 / GPIO Pin 11) [Yellow]&lt;br&gt;• Terminal 13 (BCM 27 / GPIO Pin 13) [Orange]&lt;br&gt;• Terminal 9 (GND / GPIO Ground) [Black]&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="idc">
          <mxGeometry x="5" y="5" width="200" height="140" as="geometry"/>
        </mxCell>

        <!-- 7. 12V Diaphragm Pump -->
        <mxCell id="pump" value="" style="rounded=1;fillColor=#1E293B;strokeColor=#E2E8F0;strokeWidth=2;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="210" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pump_lbl" value="&lt;b style='color:#F8FAFC;font-size:12px'&gt;12V Water Pump&lt;/b&gt;&lt;br&gt;&lt;span style='color:#94A3B8;font-size:9px'&gt;Diaphragm Motor&lt;br&gt;&lt;span style='color:#60A5FA'&gt;[Switchable via CH1]&lt;/span&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="pump">
          <mxGeometry x="5" y="10" width="140" height="60" as="geometry"/>
        </mxCell>

