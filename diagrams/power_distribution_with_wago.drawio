        <mxCell id="wire_ch2_gimbal_lbl" value="Switched V+ (CH2)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#F8FAFC;fontSize=8;backgroundColor=#0F172A;" vertex="1" connectable="0" parent="wire_ch2_gimbal">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint x="-5" y="0" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- 9. Pump GND to Wago GND Port 4 -->
        <mxCell id="wire_pump_gnd" value="" style="endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=3;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pump" target="wago_gnd">
          <mxGeometry relative="1" as="geometry">
