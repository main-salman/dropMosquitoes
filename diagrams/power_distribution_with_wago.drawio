        </mxCell>
        <mxCell id="diode_desc" value="&lt;b style='color:#F8FAFC;font-size:10px'&gt;Flyback Diode (1N4007)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#EF4444;font-size:8px'&gt;⚠ REVERSE-BIASED across pump&lt;br&gt;Cathode (Stripe) to V+ Positive&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="85" width="180" height="40" as="geometry"/>
        </mxCell>

        <!-- =================== CONNECTIONS / EDGES =================== -->

