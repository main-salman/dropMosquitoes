<mxfile>
  <diagram name="Power Entry" id="pwr1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#1a1a2e">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Title -->
        <mxCell id="t1" value="&lt;b&gt;WIRE DIAGRAM 01: Power Entry&lt;/b&gt;&lt;br&gt;AC Mains → 12V Brick → Wago Distribution" style="text;html=1;fontSize=16;fontColor=#E0E0E0;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="500" height="50" as="geometry"/></mxCell>
        <!-- AC Wall Outlet -->
        <mxCell id="ac1" value="&lt;b&gt;AC Wall Outlet&lt;/b&gt;&lt;br&gt;120V / 15A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D2D44;strokeColor=#555;fontColor=#FFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="160" height="70" as="geometry"/></mxCell>
        <!-- 12V Power Brick -->
        <mxCell id="ps1" value="&lt;b&gt;12V 10A Power Brick&lt;/b&gt;&lt;br&gt;DC 2.5×5.5mm barrel&lt;br&gt;120W output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#4CAF50;fontColor=#FFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="200" height="90" as="geometry"/></mxCell>
        <!-- AC Cable -->
        <mxCell id="e1" value="&lt;font color='#888'&gt;IEC C13 cable (included)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#888;strokeWidth=3;fontColor=#888;fontSize=10;" edge="1" parent="1" source="ac1" target="ps1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- WH-02 Pigtail -->
        <mxCell id="wh1" value="&lt;b&gt;WH-02 Pigtail Harness&lt;/b&gt;&lt;br&gt;Barrel Jack → Bare Wire&lt;br&gt;&lt;font color='#F44336'&gt;RED = +12V&lt;/font&gt;&lt;br&gt;&lt;font color='#666'&gt;BLACK = GND&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33334D;strokeColor=#FF9800;fontColor=#FFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="200" height="90" as="geometry"/></mxCell>
        <!-- Brick to WH-02 -->
        <mxCell id="e2" value="&lt;font color='#FF9800'&gt;Barrel plug snaps in&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FF9800;strokeWidth=3;fontSize=10;" edge="1" parent="1" source="ps1" target="wh1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Wago +12V -->
        <mxCell id="w12" value="&lt;b&gt;Wago 221-415&lt;/b&gt;&lt;br&gt;&lt;font color='#F44336'&gt;+12V BUS&lt;/font&gt;&lt;br&gt;5-Port Lever Nut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#F44336;fontColor=#FFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="190" height="70" as="geometry"/></mxCell>
        <!-- Wago GND -->
        <mxCell id="wgn" value="&lt;b&gt;Wago 221-415&lt;/b&gt;&lt;br&gt;&lt;font color='#666'&gt;GND BUS&lt;/font&gt;&lt;br&gt;5-Port Lever Nut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;strokeColor=#78909C;fontColor=#FFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="190" height="70" as="geometry"/></mxCell>
        <!-- WH-02 RED wire to Wago +12V -->
        <mxCell id="e3" value="&lt;font color='#F44336'&gt;RED wire → Port 1&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F44336;strokeWidth=4;fontSize=10;" edge="1" parent="1" source="wh1" target="w12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- WH-02 BLACK wire to Wago GND -->
        <mxCell id="e4" value="&lt;font color='#888'&gt;BLACK wire → Port 1&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555;strokeWidth=4;fontSize=10;" edge="1" parent="1" source="wh1" target="wgn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Port labels for +12V Wago -->
        <mxCell id="p12" value="&lt;b&gt;+12V Wago Port Map&lt;/b&gt;&lt;br&gt;Port 1: INPUT (WH-02 RED)&lt;br&gt;Port 2: → Jetson (barrel pigtail)&lt;br&gt;Port 3: → IR Illuminator (+)&lt;br&gt;Port 4: → Relay CH1 COM (pump)&lt;br&gt;Port 5: → Relay CH2 COM (gimbal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D2D44;strokeColor=#F44336;fontColor=#DDD;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1220" y="60" width="310" height="120" as="geometry"/></mxCell>
        <!-- Port labels for GND Wago -->
        <mxCell id="pgn" value="&lt;b&gt;GND Wago Port Map&lt;/b&gt;&lt;br&gt;Port 1: INPUT (WH-02 BLACK)&lt;br&gt;Port 2: → Jetson GND&lt;br&gt;Port 3: → IR Illuminator (-)&lt;br&gt;Port 4: → Pump GND (direct)&lt;br&gt;Port 5: → Gimbal GND (direct)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D2D44;strokeColor=#78909C;fontColor=#DDD;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="310" height="120" as="geometry"/></mxCell>
        <!-- Note -->
        <mxCell id="n1" value="⚠ Mount height: 8-10 ft overhead. Route power cable down the mounting pole." style="text;html=1;fontSize=11;fontColor=#FF9800;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="500" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
