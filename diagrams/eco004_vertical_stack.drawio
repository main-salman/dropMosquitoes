<mxfile>
  <diagram name="ECO-004 Vertical Assembly Stack" id="eco004_stack">
    <mxGraphModel dx="800" dy="1400" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1400" background="#FFFFFF">
      <root>
