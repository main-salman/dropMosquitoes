<mxfile>
  <diagram name="ECO-004 Vertical Assembly Stack" id="eco004_stack">
    <mxGraphModel dx="800" dy="1500" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1500" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Title -->
        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;ECO-2026-004: Vertical Assembly Stack&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666;font-size:11px'&gt;MG996R Servo Turret — Solenoid mounted on turret payload, direct to nozzle&lt;/span&gt;" style="text;html=1;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="15" width="550" height="45" as="geometry"/></mxCell>
        <!-- ===== LEVEL LABELS (left side) ===== -->
        <mxCell id="lev1" value="&lt;span style='font-size:10px;color:#999'&gt;LEVEL 1&lt;br&gt;Ground / Shelf&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="90" height="28" as="geometry"/></mxCell>
        <mxCell id="lev2" value="&lt;span style='font-size:10px;color:#999'&gt;LEVEL 2&lt;br&gt;Bracket&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="10" y="250" width="90" height="28" as="geometry"/></mxCell>
        <mxCell id="lev3" value="&lt;span style='font-size:10px;color:#999'&gt;LEVEL 3&lt;br&gt;Inline&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="10" y="420" width="90" height="28" as="geometry"/></mxCell>
        <mxCell id="lev4" value="&lt;span style='font-size:10px;color:#999'&gt;LEVEL 4&lt;br&gt;Enclosure&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="10" y="680" width="90" height="28" as="geometry"/></mxCell>
        <mxCell id="lev5" value="&lt;span style='font-size:10px;color:#999'&gt;LEVEL 5&lt;br&gt;Turret&lt;br&gt;(Moving)&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="10" y="850" width="90" height="40" as="geometry"/></mxCell>
        <!-- ===== 1. RESERVOIR ===== -->
        <mxCell id="res" value="" style="rounded=1;fillColor=#E3F2FD;strokeColor=#90CAF9;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="150" y="80" width="500" height="100" as="geometry"/></mxCell>
        <mxCell id="reswater" value="" style="rounded=0;fillColor=#42A5F5;strokeColor=#1E88E5;opacity=40;" vertex="1" parent="1"><mxGeometry x="170" y="120" width="460" height="45" as="geometry"/></mxCell>
        <mxCell id="reslbl" value="&lt;b style='color:#1565C0;font-size:14px'&gt;💧 Water Reservoir (Tote)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1976D2;font-size:10px'&gt;Gravity-fed • Mesh lid to prevent debris • Intake tube drops in&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="88" width="400" height="32" as="geometry"/></mxCell>
        <!-- Tube down to pump -->
        <mxCell id="tube1" value="" style="endArrow=block;endFill=1;strokeColor=#42A5F5;strokeWidth=8;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="180" as="sourcePoint"/><mxPoint x="400" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="tube1l" value="&lt;span style='font-size:9px;color:#42A5F5'&gt;1/4&amp;quot; silicone intake&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="190" width="100" height="14" as="geometry"/></mxCell>
        <!-- ===== 2. DIAPHRAGM PUMP ===== -->
        <mxCell id="pump" value="" style="rounded=1;fillColor=#0D47A1;strokeColor=#1565C0;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="200" y="220" width="400" height="100" as="geometry"/></mxCell>
        <mxCell id="pumpmotor" value="" style="ellipse;fillColor=#1565C0;strokeColor=#1976D2;" vertex="1" parent="1"><mxGeometry x="220" y="245" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="pumplbl" value="&lt;b style='color:#BBDEFB;font-size:14px'&gt;⚡ 12V Diaphragm Pump&lt;/b&gt;&lt;br&gt;&lt;span style='color:#90CAF9;font-size:10px'&gt;60 PSI • Self-priming • Charge bursts via Relay CH1 (BCM 17)&lt;br&gt;Outlet → Feelers 1/4&amp;quot; check valve (arrow→tank) → accumulator — holds PSI when pump OFF&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="265" y="235" width="325" height="50" as="geometry"/></mxCell>
        <!-- Tube down to adapter -->
        <mxCell id="tube2" value="" style="endArrow=block;endFill=1;strokeColor=#42A5F5;strokeWidth=8;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="320" as="sourcePoint"/><mxPoint x="400" y="360" as="targetPoint"/></mxGeometry></mxCell>
        <!-- ===== UXCELL ADAPTER IN ===== -->
        <mxCell id="ux1" value="" style="rounded=1;fillColor=#FFF8E1;strokeColor=#FFD54F;shadow=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="360" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="ux1lbl" value="&lt;b style='color:#F57F17;font-size:10px'&gt;uxcell Adapter&lt;/b&gt; &lt;span style='color:#FF8F00;font-size:9px'&gt;— 1/4&amp;quot; Barb × 1/2&amp;quot; FNPT → threads onto accumulator&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="285" y="368" width="230" height="25" as="geometry"/></mxCell>
        <!-- Into accumulator -->
        <mxCell id="tube3" value="" style="endArrow=block;endFill=1;strokeColor=#FFD54F;strokeWidth=6;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="405" as="sourcePoint"/><mxPoint x="400" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <!-- ===== 3. ACCUMULATOR TANK ===== -->
        <mxCell id="accum" value="" style="rounded=1;fillColor=#E8EAF6;strokeColor=#7986CB;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="180" y="440" width="440" height="120" as="geometry"/></mxCell>
        <mxCell id="accumbladder" value="" style="rounded=1;fillColor=#C5CAE9;strokeColor=#7986CB;arcSize=20;" vertex="1" parent="1"><mxGeometry x="200" y="460" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="accumair" value="&lt;span style='font-size:9px;color:#5C6BC0'&gt;&lt;b&gt;Air Bladder&lt;/b&gt;&lt;br&gt;Absorbs&lt;br&gt;pulsation&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="215" y="470" width="110" height="35" as="geometry"/></mxCell>
        <mxCell id="accumlbl" value="&lt;b style='color:#283593;font-size:14px'&gt;🏗️ Swess 0.75L Accumulator Tank&lt;/b&gt;&lt;br&gt;&lt;span style='color:#3F51B5;font-size:10px'&gt;125 PSI max • Dual 1/2&amp;quot; MNPT ports • Pre-charged air bladder&lt;br&gt;&lt;b style='color:#4CAF50'&gt;Converts pulsating pump → flat, constant pressure&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="265" height="50" as="geometry"/></mxCell>
        <!-- Out of accumulator -->
        <mxCell id="tube4" value="" style="endArrow=block;endFill=1;strokeColor=#FFD54F;strokeWidth=6;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="560" as="sourcePoint"/><mxPoint x="400" y="595" as="targetPoint"/></mxGeometry></mxCell>
        <!-- ===== UXCELL ADAPTER OUT ===== -->
        <mxCell id="ux2" value="" style="rounded=1;fillColor=#FFF8E1;strokeColor=#FFD54F;shadow=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="595" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="ux2lbl" value="&lt;b style='color:#F57F17;font-size:10px'&gt;uxcell Adapter&lt;/b&gt; &lt;span style='color:#FF8F00;font-size:9px'&gt;— 1/4&amp;quot; Barb × 1/2&amp;quot; FNPT → threads onto accumulator&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="285" y="603" width="230" height="25" as="geometry"/></mxCell>
        <!-- Tube to enclosure -->
        <mxCell id="tube5" value="" style="endArrow=block;endFill=1;strokeColor=#42A5F5;strokeWidth=8;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="640" as="sourcePoint"/><mxPoint x="400" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="tube5l" value="&lt;span style='font-size:9px;color:#42A5F5'&gt;1/4&amp;quot; silicone (pressurized, constant ~40 PSI)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="648" width="220" height="14" as="geometry"/></mxCell>
        <!-- ===== ENCLOSURE ===== -->
        <mxCell id="enc" value="" style="rounded=1;fillColor=#ECEFF1;strokeColor=#90A4AE;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="180" y="680" width="440" height="80" as="geometry"/></mxCell>
        <mxCell id="enclbl" value="&lt;b style='color:#37474F;font-size:12px'&gt;🔒 IP67 Dome Enclosure (passthrough)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#546E7A;font-size:9px'&gt;Jetson Orin Nano • IDC40P Terminal Block • MOSFET circuit board&lt;br&gt;Pressurized silicone line passes through PG9 cable gland to turret below&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="190" y="688" width="420" height="42" as="geometry"/></mxCell>
        <!-- Tube/cable down to turret -->
        <mxCell id="tube6" value="" style="endArrow=block;endFill=1;strokeColor=#42A5F5;strokeWidth=8;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="760" as="sourcePoint"/><mxPoint x="400" y="810" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="tube6l" value="&lt;span style='font-size:9px;color:#42A5F5'&gt;1/4&amp;quot; silicone + FPV HDMI + solenoid 12V wires&lt;br&gt;(3&amp;quot; service loop for rotation)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="768" width="230" height="22" as="geometry"/></mxCell>
        <!-- ===== TURRET BOUNDARY ===== -->
        <mxCell id="turretbox" value="" style="rounded=1;fillColor=none;strokeColor=#4CAF50;strokeWidth=3;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="120" y="810" width="560" height="370" as="geometry"/></mxCell>
        <mxCell id="turretlabel" value="&lt;b style='color:#2E7D32;font-size:13px'&gt;🎯 SERVO TURRET PAYLOAD (MOVING)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4CAF50;font-size:10px'&gt;MG996R servos (11 kg·cm) • PCA9685 PWM • Total ~275g (2.5% of stall torque)&lt;br&gt;&lt;b&gt;Mount solenoid near pivot center to minimize rotational inertia&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="140" y="815" width="520" height="45" as="geometry"/></mxCell>
        <!-- Servo motors -->
        <mxCell id="servoy" value="" style="rounded=1;fillColor=#FF6F00;strokeColor=#E65100;arcSize=8;" vertex="1" parent="1"><mxGeometry x="140" y="870" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="servoyl" value="&lt;b style='color:#FFF3E0;font-size:9px'&gt;MG996R&lt;br&gt;YAW (Pan)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="145" y="878" width="90" height="28" as="geometry"/></mxCell>
        <mxCell id="servop" value="" style="rounded=1;fillColor=#FF6F00;strokeColor=#E65100;arcSize=8;" vertex="1" parent="1"><mxGeometry x="140" y="930" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="servopl" value="&lt;b style='color:#FFF3E0;font-size:9px'&gt;MG996R&lt;br&gt;PITCH (Tilt)&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="145" y="938" width="90" height="28" as="geometry"/></mxCell>
        <!-- Camera -->
        <mxCell id="camera" value="" style="rounded=1;fillColor=#333;strokeColor=#555;arcSize=5;" vertex="1" parent="1"><mxGeometry x="280" y="875" width="80" height="50" as="geometry"/></mxCell>
        <mxCell id="camlbl" value="&lt;span style='color:#CCC;font-size:9px'&gt;&lt;b&gt;IMX219&lt;/b&gt;&lt;br&gt;Sniper Cam&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="285" y="883" width="70" height="28" as="geometry"/></mxCell>
        <!-- Kozelo IN -->
        <mxCell id="kz1" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#FFB74D;shadow=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="870" width="250" height="45" as="geometry"/></mxCell>
        <mxCell id="kz1l" value="&lt;b style='color:#E65100;font-size:10px'&gt;Kozelo Adapter&lt;/b&gt; &lt;span style='color:#BF360C;font-size:9px'&gt;1/4&amp;quot; Barb → 1/4&amp;quot; MNPT (threads into solenoid)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="405" y="878" width="240" height="25" as="geometry"/></mxCell>
        <!-- Arrow down to solenoid -->
