        <!-- SOLENOID VALVE -->
        <mxCell id="sol" value="" style="rounded=1;fillColor=#263238;strokeColor=#37474F;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="380" y="945" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="solcoil" value="" style="rounded=1;fillColor=#37474F;strokeColor=#455A64;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="955" width="100" height="25" as="geometry"/></mxCell>
        <mxCell id="sollbl" value="&lt;b style='color:#B0BEC5;font-size:12px'&gt;⚡ GOODRIG 12V Solenoid (NC)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#78909C;font-size:9px'&gt;Direct-Acting • MOSFET BCM 27 • &lt;b style='color:#4CAF50'&gt;Near pivot center&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="385" y="980" width="260" height="28" as="geometry"/></mxCell>
        <!-- Arrow down to kozelo out -->
        <mxCell id="solarr" value="" style="endArrow=block;endFill=1;strokeColor=#FFB74D;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="1015" as="sourcePoint"/><mxPoint x="525" y="1045" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="directlbl" value="&lt;b style='color:#C62828;font-size:9px'&gt;DIRECT — NO TUBING&lt;br&gt;Zero dead volume&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="545" y="1018" width="110" height="22" as="geometry"/></mxCell>
        <!-- Kozelo OUT + Nozzle -->
        <mxCell id="kz2" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#FFB74D;shadow=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="1045" width="250" height="45" as="geometry"/></mxCell>
        <mxCell id="kz2l" value="&lt;b style='color:#E65100;font-size:10px'&gt;Kozelo Adapter&lt;/b&gt; &lt;span style='color:#BF360C;font-size:9px'&gt;1/4&amp;quot; Barb → 1/4&amp;quot; MNPT (threads into solenoid out)&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="405" y="1053" width="240" height="25" as="geometry"/></mxCell>
        <!-- Arrow to nozzle -->
        <mxCell id="nozarr" value="" style="endArrow=block;endFill=1;strokeColor=#4CAF50;strokeWidth=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="1090" as="sourcePoint"/><mxPoint x="525" y="1120" as="targetPoint"/></mxGeometry></mxCell>
        <!-- NOZZLE -->
        <mxCell id="nozzle" value="" style="rounded=1;fillColor=#1B5E20;strokeColor=#2E7D32;shadow=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="1120" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="nozzletip" value="" style="triangle;fillColor=#4CAF50;strokeColor=#2E7D32;direction=south;" vertex="1" parent="1"><mxGeometry x="510" y="1140" width="20" height="25" as="geometry"/></mxCell>
        <mxCell id="nozzlelbl" value="&lt;b style='color:#A5D6A7;font-size:11px'&gt;🔫 Nozzle — fires ↓&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="445" y="1125" width="120" height="16" as="geometry"/></mxCell>
        <!-- Spray -->
        <mxCell id="spray" value="&lt;span style='font-size:22px'&gt;💧&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="505" y="1175" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="spraylbl" value="&lt;b style='color:#42A5F5;font-size:11px'&gt;Precision water pulse&lt;br&gt;40 PSI at nozzle tip&lt;br&gt;No dead volume, no drip&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="1205" width="240" height="35" as="geometry"/></mxCell>
      </root>
