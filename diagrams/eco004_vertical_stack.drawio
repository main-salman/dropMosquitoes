        <mxCell id="lev5" value="&lt;span style='font-size:10px;color:#999'&gt;LEVEL 5&lt;br&gt;Enclosure&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="10" y="740" width="90" height="28" as="geometry"/></mxCell>
        <mxCell id="lev6" value="&lt;span style='font-size:10px;color:#999'&gt;LEVEL 6&lt;br&gt;Hanging&lt;/span&gt;" style="text;html=1;align=right;" vertex="1" parent="1"><mxGeometry x="10" y="920" width="90" height="28" as="geometry"/></mxCell>
