        <mxCell id="pumplbl" value="&lt;b style='color:#BBDEFB;font-size:14px'&gt;⚡ 12V Diaphragm Pump&lt;/b&gt;&lt;br&gt;&lt;span style='color:#90CAF9;font-size:10px'&gt;60 PSI • Self-priming • Runs CONTINUOUSLY via Relay CH1 (BCM 17)&lt;br&gt;Internal check valves prevent backflow • Surface-mounted on bracket&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="265" y="235" width="325" height="50" as="geometry"/></mxCell>
