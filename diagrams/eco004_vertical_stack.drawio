        <!-- Title -->
        <mxCell id="t1" value="&lt;b style='font-size:18px'&gt;ECO-2026-004: Vertical Assembly Stack&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666;font-size:11px'&gt;Physical mounting order — top to bottom&lt;/span&gt;" style="text;html=1;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="15" width="500" height="45" as="geometry"/></mxCell>
