        <mxCell id="reslbl" value="&lt;b style='color:#1565C0;font-size:14px'&gt;💧 Water Reservoir (Tote)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1976D2;font-size:10px'&gt;Gravity-fed • Mesh lid to prevent debris • Intake tube drops in&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="88" width="400" height="32" as="geometry"/></mxCell>
