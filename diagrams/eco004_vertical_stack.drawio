        <mxCell id="tube1l" value="&lt;span style='font-size:9px;color:#42A5F5'&gt;1/4&amp;quot; silicone intake&lt;/span&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="190" width="100" height="14" as="geometry"/></mxCell>
