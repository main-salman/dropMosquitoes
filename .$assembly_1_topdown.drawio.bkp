<mxfile host="app.diagrams.net">
  <diagram name="Diagram 1: Top-Down Enclosure Assembly" id="topdown">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DIAGRAM 1: TOP-DOWN ASSEMBLY — IP67 MASTER ENCLOSURE (Open Lid View)" style="text;html=1;fontSize=16;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="10" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="legend" value="LEGEND:  ── Solid Arrow = FASTEN to Grid Plate  │  - - Dashed = ROUTE / CABLE" style="text;html=1;fontSize=10;fontStyle=2;align=left;fillColor=#FFFFCC;strokeColor=#CCCC00;rounded=1;" vertex="1" parent="1"><mxGeometry x="200" y="45" width="500" height="25" as="geometry"/></mxCell>

        <!-- IP67 Enclosure outline -->
        <mxCell id="enc" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="100" y="90" width="1100" height="750" as="geometry"/></mxCell>
        <mxCell id="enc_label" value="Joinfworld IP67 Enclosure&#xa;Grey — 11.4&quot; × 7.5&quot; × 5.5&quot;&#xa;(Open Lid View — Looking Down)" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="350" y="95" width="500" height="50" as="geometry"/></mxCell>
        <mxCell id="grid" value="DIN Rail / Grid Plate (base)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#999;strokeWidth=1;dashed=1;fontSize=9;fontColor=#999;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="1060" height="670" as="geometry"/></mxCell>

        <!-- BALLOON 1: Yahboom Brain -->
        <mxCell id="brain" value="🧠 Yahboom Orin Nano SUPER&#xa;(Metal Mini PC Kit)&#xa;w/ 256GB SSD &amp; Heatsink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76B947;strokeColor=#36802d;fontStyle=1;fontSize=11;fontColor=#FFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="140" y="180" width="480" height="280" as="geometry"/></mxCell>
        <mxCell id="b1" value="①" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#CC3300;fontStyle=1;fontSize=16;fontColor=#FFF;" vertex="1" parent="1"><mxGeometry x="130" y="170" width="35" height="35" as="geometry"/></mxCell>
        <mxCell id="b1_note" value="① FASTEN: Yahboom Metal Case&#xa;to Grid Plate via 4x M3 Standoffs&#xa;(15mm height for airflow)" style="text;html=1;fontSize=9;fontStyle=0;align=left;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="standoff1" value="M3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCC;strokeColor=#999;fontSize=7;" vertex="1" parent="1"><mxGeometry x="160" y="200" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="standoff2" value="M3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCC;strokeColor=#999;fontSize=7;" vertex="1" parent="1"><mxGeometry x="580" y="200" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="standoff3" value="M3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCC;strokeColor=#999;fontSize=7;" vertex="1" parent="1"><mxGeometry x="160" y="420" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="standoff4" value="M3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCC;strokeColor=#999;fontSize=7;" vertex="1" parent="1"><mxGeometry x="580" y="420" width="20" height="20" as="geometry"/></mxCell>
        <!-- Fasten arrows from brain to grid -->
        <mxCell id="fa1" style="strokeColor=#333;strokeWidth=2;endArrow=block;entryX=0.5;entryY=0.5;" edge="1" source="standoff1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="240" as="targetPoint"/></mxGeometry></mxCell>

        <!-- BALLOON 2: Wago Connectors -->
        <mxCell id="wago1" value="⚡ Wago 221-415&#xa;+12V Dist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9999;strokeColor=#CC0000;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="wago2" value="⏚ Wago 221-415&#xa;GND Dist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333;strokeColor=#000;fontStyle=1;fontSize=9;fontColor=#FFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="280" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="b2" value="②" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#CC3300;fontStyle=1;fontSize=16;fontColor=#FFF;" vertex="1" parent="1"><mxGeometry x="690" y="190" width="35" height="35" as="geometry"/></mxCell>
        <mxCell id="b2_note" value="② FASTEN: Two Wago 5-Port&#xa;connectors to Grid Plate.&#xa;Use adhesive-backed DIN clip." style="text;html=1;fontSize=9;fontStyle=0;align=left;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="230" height="50" as="geometry"/></mxCell>

        <!-- BALLOON 3: Monk Makes Relay -->
        <mxCell id="relay" value="🛡️ Monk Makes&#xa;Dual Relay Module&#xa;CH1: Pump | CH2: Gimbal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6666;strokeColor=#CC0000;fontStyle=1;fontSize=10;fontColor=#FFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="440" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="b3" value="③" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#CC3300;fontStyle=1;fontSize=16;fontColor=#FFF;" vertex="1" parent="1"><mxGeometry x="690" y="430" width="35" height="35" as="geometry"/></mxCell>
        <mxCell id="b3_note" value="③ FASTEN: Relay board to&#xa;Grid Plate via 2x M2.5 Standoffs.&#xa;Keep ≥2cm from Yahboom heatsink." style="text;html=1;fontSize=9;fontStyle=0;align=left;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1"><mxGeometry x="700" y="550" width="250" height="50" as="geometry"/></mxCell>

        <!-- BALLOON 4: CSI-HDMI TX Boards -->
        <mxCell id="csi_tx1" value="CSI→HDMI TX Board 1&#xa;(Scout Chain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="csi_tx2" value="CSI→HDMI TX Board 2&#xa;(Sniper Chain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="960" y="280" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="b4" value="④" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF6600;strokeColor=#CC3300;fontStyle=1;fontSize=16;fontColor=#FFF;" vertex="1" parent="1"><mxGeometry x="950" y="190" width="35" height="35" as="geometry"/></mxCell>
        <mxCell id="b4_note" value="④ FASTEN: Two CSI→HDMI TX boards&#xa;via adhesive standoffs on right wall.&#xa;HDMI ports face outward toward glands." style="text;html=1;fontSize=9;fontStyle=0;align=left;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1"><mxGeometry x="940" y="350" width="260" height="50" as="geometry"/></mxCell>

        <!-- Route arrows (dashed) showing internal wiring -->
        <mxCell id="r1" value="40-pin Jumper (GPIO)" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0000CC;strokeWidth=2;dashed=1;endArrow=open;" edge="1" source="brain" target="relay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" value="15-pin FPC" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0000CC;strokeWidth=2;dashed=1;endArrow=open;" edge="1" source="brain" target="csi_tx1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="r3" value="15-pin FPC" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0000CC;strokeWidth=2;dashed=1;endArrow=open;" edge="1" source="brain" target="csi_tx2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="310"/></Array></mxGeometry></mxCell>
        <mxCell id="r4" value="Red/Black 16AWG" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#CC0000;strokeWidth=3;dashed=1;endArrow=open;" edge="1" source="wago1" target="relay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Assembly order note -->
        <mxCell id="order" value="ASSEMBLY ORDER:&#xa;1. Mount Standoffs to Grid Plate&#xa;2. Seat Yahboom case on standoffs (①)&#xa;3. Clip Wago connectors to plate (②)&#xa;4. Mount Relay on standoffs (③)&#xa;5. Adhesive-mount CSI TX boards (④)&#xa;6. Route all internal cables (dashed lines)" style="text;html=1;fontSize=10;fontStyle=0;align=left;fillColor=#E6FFE6;strokeColor=#82B366;rounded=1;" vertex="1" parent="1"><mxGeometry x="140" y="680" width="320" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
