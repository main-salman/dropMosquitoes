# Sniper Messy Mortar — Systemd Auto-Start Service
# Runs the AI sentry pipeline on boot with full camera/GPIO init.
#
# INSTALL (from Jetson):
#   sudo cp sentry.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable sentry.service
#
# LOGS:
#   journalctl -u sentry -f
#   tail -f /home/jetson/dropMosquitoes/sentry.log
#
# STOP:
#   sudo systemctl stop sentry.service

[Unit]
Description=Sniper Messy Mortar — AI Mosquito Sentry
After=network-online.target nvargus-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/jetson/dropMosquitoes

# --- Pre-start: maximize performance ---
ExecStartPre=-/bin/bash -c '/usr/sbin/nvpmodel -m 0 && /usr/bin/jetson_clocks'

# --- Pre-start: full camera subsystem reset ---
# Ensures clean CSI state on every boot (prevents garbled Sniper video).
ExecStartPre=-/bin/bash -c 'systemctl stop nvargus-daemon; sleep 1; modprobe -r nv_imx219; sleep 2; modprobe nv_imx219; sleep 2; systemctl start nvargus-daemon; sleep 3'

# --- Pre-start: configure GPIO pinmux (push-pull mode for relay pins) ---
ExecStartPre=-/usr/bin/python3 -c 'import mmap, struct; f = open("/dev/mem", "r+b"); mem = mmap.mmap(f.fileno(), 0x10000, offset=0x02430000); mem[0x98:0x9c] = struct.pack("<I", struct.unpack("<I", mem[0x98:0x9c])[0] & ~(1 << 4)); mem[0xd030:0xd034] = struct.pack("<I", struct.unpack("<I", mem[0xd030:0xd034])[0] & ~(1 << 4))'

# --- Main: start the sentry server ---
ExecStart=/usr/bin/python3 -u app.py --port 8000

# --- Lifecycle ---
Restart=on-failure
RestartSec=15
StandardOutput=append:/home/jetson/dropMosquitoes/sentry.log
StandardError=append:/home/jetson/dropMosquitoes/sentry.log

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/jetson/.local/lib/python3.10/site-packages

[Install]
WantedBy=multi-user.target
