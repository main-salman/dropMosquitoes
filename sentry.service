# Sniper Messy Mortar — Systemd Auto-Start Service
# Runs the AI sentry pipeline on boot with full camera/GPIO init.
#
# INSTALL (from Jetson):
#   sudo cp sentry.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable sentry.service
#
# LOGS:
#   journalctl -u sentry -f
#   tail -f /home/jetson/dropMosquitoes/sentry.log
#
# STOP:
#   sudo systemctl stop sentry.service

[Unit]
Description=Sniper Messy Mortar — AI Mosquito Sentry
After=network-online.target nvargus-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/jetson/dropMosquitoes

# --- FIRST: pinmux + SIG LOW (before slow nvargus wait) ---
# Rev J jumpered module 12V: boot firmware drives PR.05 HIGH → FETs heat until
# userspace claims SIG. This shortens that window. Full safety = series switch
# on module 12V (HW-001 §5.5) — open during power-on, close after dashboard up.
ExecStartPre=-/usr/bin/python3 /home/jetson/dropMosquitoes/scripts/claim_sig_low.py

# --- Pre-start: maximize performance ---
ExecStartPre=-/bin/bash -c '/usr/sbin/nvpmodel -m 0 && /usr/bin/jetson_clocks'

# --- Pre-start: camera subsystem ---
# NOTE: Do NOT modprobe -r/modprobe nv_imx219 here. The MIPI CSI-2 PHY retains
# lane sync state that modprobe cannot clear, causing garbled video on sensor-1.
# Clean camera state requires a full Jetson reboot (handled by run-ai.sh).
ExecStartPre=-/bin/bash -c 'systemctl restart nvargus-daemon; sleep 3'

# --- Re-assert SIG LOW after nvargus wait (app claims next) ---
ExecStartPre=-/usr/bin/python3 /home/jetson/dropMosquitoes/scripts/claim_sig_low.py

# --- Main: start the sentry server ---
ExecStart=/usr/bin/python3 -u app.py --port 8000

# --- Lifecycle ---
Restart=on-failure
RestartSec=15
StandardOutput=append:/home/jetson/dropMosquitoes/sentry.log
StandardError=append:/home/jetson/dropMosquitoes/sentry.log

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/jetson/.local/lib/python3.10/site-packages
Environment=TZ=America/New_York

[Install]
WantedBy=multi-user.target
